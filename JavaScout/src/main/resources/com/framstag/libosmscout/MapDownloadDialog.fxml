<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<DialogPane fx:controller="com.framstag.libosmscout.MapDownloadController"
            xmlns:fx="http://javafx.com/fxml"
            prefWidth="700" prefHeight="500">

    <content>
        <TabPane tabClosingPolicy="UNAVAILABLE">
            <!-- Available Maps tab -->
            <Tab text="Available Maps">
                <VBox spacing="8">
                    <padding><Insets top="8" right="8" bottom="8" left="8"/></padding>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="Provider:" />
                        <ComboBox fx:id="providerCombo" prefWidth="250" />
                        <Button fx:id="refreshBtn" text="Refresh" onAction="#onRefresh" />
                    </HBox>
                    <TreeView fx:id="availableTree" VBox.vgrow="ALWAYS" />
                    <HBox spacing="8" alignment="CENTER_RIGHT">
                        <Label fx:id="selectedMapLabel" text="Select a map" HBox.hgrow="ALWAYS" />
                        <Button fx:id="downloadBtn" text="Download" onAction="#onDownload"
                                disable="true" />
                    </HBox>
                </VBox>
            </Tab>

            <!-- Downloads tab -->
            <Tab text="Downloads">
                <VBox spacing="8">
                    <padding><Insets top="8" right="8" bottom="8" left="8"/></padding>
                    <TableView fx:id="downloadsTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn text="Map" fx:id="mapNameCol" prefWidth="150" />
                            <TableColumn text="Progress" fx:id="progressCol" prefWidth="100" />
                            <TableColumn text="Status" fx:id="statusCol" prefWidth="200" />
                            <TableColumn text="Target" fx:id="targetCol" prefWidth="200" />
                        </columns>
                    </TableView>
                    <HBox spacing="8" alignment="CENTER_RIGHT">
                        <Button text="Cancel Selected" onAction="#onCancelDownload" />
                    </HBox>
                </VBox>
            </Tab>

            <!-- Installed Maps tab -->
            <Tab text="Installed Maps">
                <VBox spacing="8">
                    <padding><Insets top="8" right="8" bottom="8" left="8"/></padding>
                    <ListView fx:id="installedList" VBox.vgrow="ALWAYS" />
                    <HBox spacing="8" alignment="CENTER_RIGHT">
                        <Button text="Delete Selected" onAction="#onDeleteMap" />
                        <Button text="Refresh" onAction="#onRefreshInstalled" />
                    </HBox>
                </VBox>
            </Tab>

            <!-- Basemap tab -->
            <Tab text="Basemap">
                <VBox spacing="8">
                    <padding><Insets top="8" right="8" bottom="8" left="8"/></padding>
                    <VBox spacing="4">
                        <Label text="World Basemap" style="-fx-font-weight: bold; -fx-font-size: 14px;" />
                        <Label text="A world-wide map with borders, country names, and coastlines." wrapText="true" />
                    </VBox>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="Status:" />
                        <Label fx:id="basemapStatusLabel" text="Checking..." />
                    </HBox>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="Available:" />
                        <Label fx:id="basemapAvailableLabel" text="-" />
                    </HBox>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="Installed:" />
                        <Label fx:id="basemapInstalledLabel" text="-" />
                    </HBox>
                    <HBox spacing="8" alignment="CENTER_RIGHT">
                        <ComboBox fx:id="basemapVariantCombo" prefWidth="250" visible="false" />
                        <Button fx:id="basemapActionBtn" text="Check Server" onAction="#onBasemapAction" />
                    </HBox>
                </VBox>
            </Tab>
        </TabPane>
    </content>

</DialogPane>
