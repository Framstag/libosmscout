# syntax=docker/dockerfile:1
#
# serve image: read-only static web server for the public part of the map
# repository. The repository volume is mounted at /repository (read-only);
# the served root is /repository/public. The private part is outside the
# served root and therefore never reachable. No authentication.
#
# The nginx master process runs as the unprivileged "nginx" user: binding
# port 80 still works because container runtimes grant CAP_NET_BIND_SERVICE
# by default. Pid and temp files live under /tmp (world-writable), so no
# root-owned state is needed at runtime.
#
# Build:
#   docker build -f scripts/mapgen/Dockerfile.serve -t osmscout-mapserve:<version> .
#
# Run (with the mapgen image, see docker-compose.yml):
#   docker run --rm -p 8080:80 \
#     -v /repository:/repository:ro osmscout-mapserve:<version>

FROM nginx:1.27-alpine

COPY scripts/mapgen/nginx-serve-main.conf /etc/nginx/nginx.conf
COPY scripts/mapgen/nginx-serve.conf /etc/nginx/conf.d/default.conf

# workers keep their cache/temp state under /var/cache/nginx; make it
# writable by the unprivileged user (temp dirs are also configured under
# /tmp in the main config, this covers any remaining runtime writes).
RUN chown -R nginx:nginx /var/cache/nginx

# bypass the official entrypoint (no envsubst templates are used) and run
# the master process as the nginx user instead of root; reset the base image
# CMD so it does not append further nginx arguments
ENTRYPOINT ["nginx", "-g", "daemon off;"]
CMD []
USER nginx

EXPOSE 80
