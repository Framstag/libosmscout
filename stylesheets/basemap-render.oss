OSS
// Stylesheet for basemap rendering
// Only includes types present in the basemap data (basemap.ost + water index)
// MAG ranges mirror include/place.oss so basemap labels persist at the same
// zoom levels as the standard stylesheet.

FLAG
  daylight          = true;

CONST
  IF daylight {
    COLOR waterColor               = #9acffd;
    COLOR landColor                = #f1eee9;
    COLOR unknownColor             = @waterColor;
    COLOR countryBorderColor       = #888888;
    COLOR placeLabelColor          = #000000;
    COLOR placeEmphasizeColor      = #cccccc;
    COLOR oceanLabelColor          = #000040;
    COLOR seaLabelColor            = #6060b0;
  }
  ELSE {
    COLOR waterColor               = darken(#9acffd, 0.5);
    COLOR landColor                = #333333;
    COLOR unknownColor             = #000000;
    COLOR countryBorderColor       = #888888;
    COLOR placeLabelColor          = #a0a0a0;
    COLOR placeEmphasizeColor      = #909090;
    COLOR oceanLabelColor          = #000020;
    COLOR seaLabelColor            = #000020;
  }

  // Label priorities (mirror include/place.oss)
  UINT labelPrioContinent           = 1;
  UINT labelPrioOcean               = 2;
  UINT labelPrioSea                 = 4;
  UINT labelPrioCountry             = 2;
  UINT labelPrioCapitalCity         = 6;
  UINT labelPrioMillionCity         = 7;

  // Symbols (duplicated from include/place.oss — including the module would
  // pull in style rules for types not present in the basemap database)
  SYMBOL place_capital_city
    CIRCLE 0,0 0.8 {
      AREA.BORDER {color: #8a4e4e; width: 0.5mm; }
    }
    CIRCLE 0,0 0.2 {
      AREA {color: #8a4e4e; }
    }

  SYMBOL place_city
    CIRCLE 0,0 0.8 {
      AREA.BORDER {color: #888888; width: 0.5mm; }
    }

STYLE
  // Land/sea from water index
  [MAG 0-] {
    [TYPE _tile_sea] AREA {color: @waterColor;}
    [TYPE _tile_land] AREA {color: @landColor;}
    [TYPE _tile_unknown] AREA {color: @unknownColor;}
  }

  // Country borders (mirror include/basemap.oss)
  [TYPE basemap_boundary_country] {
    [MAG 2-3] {
        WAY {color: alpha(@countryBorderColor, 0.1); displayWidth: 0.1mm;}
        AREA.BORDER { color: alpha(@countryBorderColor, 0.1); width: 0.1mm;}
    }
    [MAG continent-stateOver] {
        WAY {color: alpha(@countryBorderColor, 0.3); displayWidth: 0.1mm;}
        AREA.BORDER { color: alpha(@countryBorderColor, 0.3); width: 0.1mm;}
    }
  }

  // Continents (mirror include/place.oss)
  [TYPE place_continent] {
    [MAG world-continent] NODE.TEXT {label: Name.name; size: 0.8; style: emphasize; emphasizeColor: @placeEmphasizeColor; color: alpha(@placeLabelColor, 0.5); priority: @labelPrioContinent; }
    [MAG 2-continent] NODE.TEXT {label: Name.name; size: 2.0; color: alpha(@placeLabelColor, 0.37); priority: @labelPrioContinent; }
    [MAG 3-continent] NODE.TEXT {label: Name.name; size: 4.0; priority: @labelPrioContinent; }
    [MAG continent-continent] NODE.TEXT {label: Name.name; size: 6.0; color: alpha(@placeLabelColor, 0.1); priority: @labelPrioContinent; }
  }

  // Oceans (mirror include/place.oss)
  [TYPE place_ocean] {
    [MAG world-continent] NODE.TEXT {label: Name.name; size: 0.6; color: alpha(@oceanLabelColor, 0.5); priority: @labelPrioOcean; }
    [MAG 2-continent] NODE.TEXT {label: Name.name; size: 1.8; color: alpha(@oceanLabelColor, 0.35); priority: @labelPrioOcean; }
    [MAG 3-continent] NODE.TEXT {label: Name.name; size: 4.0; color: alpha(@oceanLabelColor, 0.20); priority: @labelPrioOcean; }
  }

  // Seas (mirror include/place.oss)
  [TYPE place_sea] {
    [MAG continent-stateOver] {
        NODE.TEXT { label: Name.name; size: 2.0; color: alpha(@seaLabelColor, 0.7); priority: @labelPrioSea; }
        AREA.TEXT { label: Name.name; size: 2.0; color: alpha(@seaLabelColor, 0.7); autoSize: true; priority: @labelPrioSea; }
        AREA.BORDER { color: alpha(@seaLabelColor, 0.2); width: 0.1mm; dash: 1,10; }
    }
  }

  // Countries (mirror include/place.oss)
  [MAG continent-stateOver] {
    [TYPE place_country] NODE.TEXT {label: Name.name; size: 2.2; style: emphasize; emphasizeColor: @placeEmphasizeColor; color: @placeLabelColor; priority: @labelPrioCountry; }
  }
  [MAG state-] {
    [TYPE place_country] NODE.TEXT {label: Name.name; size: 3.0; color: alpha(@placeLabelColor, 0.5); priority: @labelPrioCountry; }
  }
  [MAG stateOver-] {
    [TYPE place_country] NODE.TEXT {label: Name.name; size: 4.0; color: alpha(@placeLabelColor, 0.37); priority: @labelPrioCountry; }
  }

  // Capital and million cities (mirror include/place.oss)
  [MAG state-city] {
    [TYPE place_capitalcity] {
       NODE.TEXT {label: Name.name; style: emphasize; emphasizeColor: @placeEmphasizeColor; color: @placeLabelColor; position: 2; size: 1.4; priority: @labelPrioCapitalCity; }
       NODE.ICON { symbol: place_capital_city; position: 1; priority: @labelPrioCapitalCity; }
    }
    [TYPE place_millioncity] {
       NODE.TEXT {label: Name.name; style: emphasize; emphasizeColor: @placeEmphasizeColor; color: @placeLabelColor; position: 2; size: 1.4; priority: @labelPrioMillionCity; }
       NODE.ICON { symbol: place_city; position: 1; priority: @labelPrioMillionCity; }
    }
  }

  // Area text for place areas (mirror include/place.oss county-)
  [MAG county-] {
    [TYPE place_continent,
          place_capitalcity,
          place_millioncity] AREA.TEXT { label: Name.name; color: @placeLabelColor; autoSize: true; }
  }
END
