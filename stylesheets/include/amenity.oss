    [TYPE amenity_music_school] NODE.ICON { symbol: amenity_nightclub; }
    [TYPE amenity_music_school_building] AREA.ICON { symbol: amenity_nightclub; }

    [TYPE amenity_townhall] NODE.ICON { symbol: amenity_townhall; }
    [TYPE amenity_townhall_building] AREA.ICON { symbol: amenity_townhall; }
    [TYPE amenity_marketplace] NODE.ICON { symbol: amenity_marketplace; }
    [TYPE amenity_marketplace] AREA.ICON { symbol: amenity_marketplace; }
    [TYPE amenity_prison] NODE.ICON { symbol: amenity_prison; }
    [TYPE amenity_prison_building] AREA.ICON { symbol: amenity_prison; }

    [TYPE amenity_bbq] NODE.ICON { symbol: amenity_bbq; }
    [TYPE amenity_hunting_stand] NODE.ICON { symbol: amenity_hunting_stand; }
    [TYPE amenity_ice_cream] NODE.ICON { symbol: amenity_ice_cream; }
    [TYPE amenity_car_wash] NODE.ICON { symbol: amenity_car_wash; }
    [TYPE amenity_car_rental] NODE.ICON { symbol: amenity_car_wash; }
    [TYPE amenity_car_rental_building] AREA.ICON { symbol: amenity_car_wash; }
    [TYPE amenity_car_sharing] NODE.ICON { symbol: amenity_car_wash; }

    [TYPE amenity_parcel_locker] NODE.ICON { symbol: amenity_parcel_locker; }
    [TYPE amenity_post_depot] NODE.ICON { symbol: amenity_post_office; }
    [TYPE amenity_post_depot_building] AREA.ICON { symbol: amenity_post_office; }

    [TYPE amenity_shower] NODE.ICON { symbol: amenity_shower; }
    [TYPE amenity_public_bath] NODE.ICON { symbol: amenity_public_bath; }
    [TYPE amenity_public_bath_building] AREA.ICON { symbol: amenity_public_bath; }

    [TYPE amenity_university] NODE.ICON { symbol: amenity_university; }
    [TYPE amenity_university_building] AREA.ICON { symbol: amenity_university; }
    [TYPE amenity_college] NODE.ICON { symbol: amenity_university; }
    [TYPE amenity_college_building] AREA.ICON { symbol: amenity_university; }

    [TYPE amenity_motorcycle_parking] NODE.ICON { symbol: amenity_motorcycle_parking; }
    [TYPE amenity_bicycle_rental] NODE.ICON { symbol: amenity_bicycle_parking; }

    [TYPE amenity_community_centre] NODE.ICON { symbol: amenity_community_centre; }
    [TYPE amenity_community_centre_building] AREA.ICON { symbol: amenity_community_centre; }

    [TYPE amenity_veterinary] NODE.ICON { symbol: amenity_veterinary; }
    [TYPE amenity_veterinary_building] AREA.ICON { symbol: amenity_veterinary; }
    [TYPE amenity_clinic,
          amenity_clinic_building,
          amenity_dentist,
          amenity_dentist_building,
          amenity_health_post] NODE.ICON { symbol: amenity_hospital; }

    [TYPE amenity_boat_rental] NODE.ICON { symbol: amenity_boat_rental; }
    [TYPE amenity_boat_storage] NODE.ICON { symbol: amenity_boat_rental; }

    [TYPE amenity_biergarten] NODE.ICON { symbol: amenity_biergarten; }

    [TYPE amenity_bicycle_parking] WAY { color: #666666; displayWidth: 0.1mm; dash: 1,1; }

    // Amenities without special color
    [TYPE amenity,
          amenity_bank,
          amenity_cafe,
          amenity_fast_food,
          amenity_fuel,
          amenity_kindergarten,
          amenity_library,
          amenity_recycling,
          amenity_restaurant,
          amenity_school,
          amenity_food_court,
          amenity_dancing_school,
          amenity_driving_school,
          amenity_training,
          amenity_research_institute,
          amenity_dojo,
          amenity_bicycle_repair_station,
          amenity_vehicle_inspection,
          amenity_weighbridge,
          amenity_public_bookcase,
          amenity_bureau_de_change,
          amenity_money_transfer,
          amenity_mobile_money_agent,
          amenity_social_facility,
          amenity_social_centre,
          amenity_conference_centre,
          amenity_events_venue,
          amenity_arts_centre,
          amenity_gambling,
          amenity_studio,
          amenity_crematorium,
          amenity_funeral_hall,
          amenity_ranger_station,
          amenity_internet_cafe,
          amenity_driver_training,
          amenity_lavoir,
          amenity_waste_transfer_station,
          amenity_animal_shelter,
          amenity_animal_boarding,
          amenity_animal_breeding,
          amenity_monastery,
          amenity_monastery_building] {
      NODE.ICON { symbol: amenity; }
    }
