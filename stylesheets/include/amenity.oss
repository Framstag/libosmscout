    [TYPE amenity_atm] NODE.ICON { symbol: amenity_atm; }

    // Amenity icons
    [TYPE amenity_fire_station] NODE.ICON { symbol: amenity_fire_station; }
    [TYPE amenity_fire_station_building] AREA.ICON { symbol: amenity_fire_station; }

    [TYPE amenity_telephone] NODE.ICON { symbol: amenity_telephone; }

    [TYPE amenity_fountain] {
