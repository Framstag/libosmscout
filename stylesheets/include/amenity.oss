    [TYPE amenity_cinema_building] AREA.ICON { symbol: amenity_cinema; }
    [TYPE amenity_theatre] NODE.ICON { symbol: amenity_theatre; }
    [TYPE amenity_theatre_building] AREA.ICON { symbol: amenity_theatre; }
