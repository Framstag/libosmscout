    // Door
    RECTANGLE -0.12,0.3 0.24 x 0.2 { AREA { color: #ffffff; } }

  SYMBOL historic_round_tower
    // Round tower
    CIRCLE 0,-0.1 0.45 { AREA { color: @historicSymbolColor; } }
    // Roof
    POLYGON -0.5,-0.1 0.5,-0.1 0,-0.8 { AREA { color: @historicSymbolColor; } }

  SYMBOL historic_city_gate
    // Pillars
    RECTANGLE -0.6,-0.5 0.5 x 1.0 { AREA { color: @historicSymbolColor; } }
    RECTANGLE 0.1,-0.5 0.5 x 1.0 { AREA { color: @historicSymbolColor; } }
    // Lintel
