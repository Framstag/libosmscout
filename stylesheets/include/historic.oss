    CIRCLE 0,-0.8 0.15 { AREA.BORDER { color: @historicSymbolColor; width: 0.1mm; } }
    // Shank
    RECTANGLE -0.06,-0.65 0.12 x 0.9 { AREA { color: @historicSymbolColor; } }
    // Crossbar
    RECTANGLE -0.5,-0.1 1.0 x 0.12 { AREA { color: @historicSymbolColor; } }
    // Flukes
    POLYGON -0.5,-0.1 -0.2,-0.1 -0.35,0.3 { AREA { color: @historicSymbolColor; } }
    POLYGON 0.5,-0.1 0.2,-0.1 0.35,0.3 { AREA { color: @historicSymbolColor; } }

  SYMBOL historic_stone
