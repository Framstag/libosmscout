    RECTANGLE -0.8,-0.2 1.6 x 0.5 { AREA { color: @historicSymbolColor; } }
    // Wheels
    CIRCLE -0.5,0.3 0.12 { AREA { color: @historicSymbolColor; } }
    CIRCLE 0.5,0.3 0.12 { AREA { color: @historicSymbolColor; } }

  SYMBOL historic_tank
    // Hull
    RECTANGLE -0.7,-0.1 1.4 x 0.4 { AREA { color: @historicSymbolColor; } }
    // Turret
