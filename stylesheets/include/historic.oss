OSS

  //
  // Historic
  //

  CONST
    COLOR historicColor       = #b6845a;
    COLOR historicSymbolColor = darken(@historicColor, 0.2);
    COLOR historicBorderColor = darken(@historicColor, 0.3);
    COLOR historicLabelColor  = darken(@historicColor, 0.5);

  SYMBOL historic
    RECTANGLE 0,0 2.25 x 2.25 {
      AREA {color: @historicSymbolColor; }
    }

  SYMBOL historic_castle
    // Tower
    RECTANGLE -0.45,-0.85 0.9 x 1.0 { AREA { color: @historicSymbolColor; } }
    // Merlons
    RECTANGLE -0.45,-1.0 0.25 x 0.25 { AREA { color: @historicSymbolColor; } }
    RECTANGLE -0.1,-1.0 0.2 x 0.25 { AREA { color: @historicSymbolColor; } }
    RECTANGLE 0.2,-1.0 0.25 x 0.25 { AREA { color: @historicSymbolColor; } }
    // Gate
    RECTANGLE -0.15,-0.1 0.3 x 0.25 { AREA { color: #ffffff; } }

  SYMBOL historic_fort
    // Bastion star
    POLYGON 0,-1.0 0.35,-0.35 1.0,0 0.35,0.35 0,1.0 -0.35,0.35 -1.0,0 -0.35,-0.35 { AREA { color: @historicSymbolColor; } }

  SYMBOL historic_church
    // Building
    RECTANGLE -0.5,0.0 1.0 x 0.7 { AREA { color: @historicSymbolColor; } }
    // Roof
    POLYGON -0.6,0.0 0.6,0.0 0,-0.5 { AREA { color: @historicSymbolColor; } }
    // Cross
    RECTANGLE -0.05,-0.85 0.1 x 0.35 { AREA { color: @historicSymbolColor; } }
    RECTANGLE -0.2,-0.7 0.4 x 0.1 { AREA { color: @historicSymbolColor; } }

  SYMBOL historic_chapel
    // Small building
    RECTANGLE -0.4,0.0 0.8 x 0.6 { AREA { color: @historicSymbolColor; } }
    // Roof
    POLYGON -0.5,0.0 0.5,0.0 0,-0.4 { AREA { color: @historicSymbolColor; } }
    // Cross
    RECTANGLE -0.04,-0.7 0.08 x 0.3 { AREA { color: @historicSymbolColor; } }
    RECTANGLE -0.16,-0.6 0.32 x 0.08 { AREA { color: @historicSymbolColor; } }

  SYMBOL historic_monastery
    // Building
    RECTANGLE -0.6,0.0 1.2 x 0.6 { AREA { color: @historicSymbolColor; } }
    // Roof
    POLYGON -0.7,0.0 0.7,0.0 0,-0.45 { AREA { color: @historicSymbolColor; } }
    // Cross
    RECTANGLE -0.05,-0.8 0.1 x 0.35 { AREA { color: @historicSymbolColor; } }
    RECTANGLE -0.2,-0.65 0.4 x 0.1 { AREA { color: @historicSymbolColor; } }

  SYMBOL historic_mosque
    // Dome
    POLYGON -0.45,-0.5 0.45,-0.5 0,-1.0 { AREA { color: @historicSymbolColor; } }
    // Base
    RECTANGLE -0.5,-0.5 1.0 x 0.3 { AREA { color: @historicSymbolColor; } }
    // Minaret
    RECTANGLE 0.55,-0.9 0.2 x 0.9 { AREA { color: @historicSymbolColor; } }
    POLYGON 0.5,-0.9 0.8,-0.9 0.65,-1.0 { AREA { color: @historicSymbolColor; } }

  SYMBOL historic_temple
    // Pediment
    POLYGON -0.7,-0.3 0.7,-0.3 0,-0.8 { AREA { color: @historicSymbolColor; } }
    // Columns
    RECTANGLE -0.5,-0.3 0.15 x 0.7 { AREA { color: @historicSymbolColor; } }
    RECTANGLE -0.075,-0.3 0.15 x 0.7 { AREA { color: @historicSymbolColor; } }
    RECTANGLE 0.35,-0.3 0.15 x 0.7 { AREA { color: @historicSymbolColor; } }
    // Base
    RECTANGLE -0.6,0.4 1.2 x 0.15 { AREA { color: @historicSymbolColor; } }

  SYMBOL historic_tower
    // Tower
