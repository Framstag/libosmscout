    // Wheels
    CIRCLE -0.45,0.4 0.15 { AREA { color: @historicSymbolColor; } }
    CIRCLE -0.1,0.4 0.15 { AREA { color: @historicSymbolColor; } }
    CIRCLE 0.3,0.4 0.15 { AREA { color: @historicSymbolColor; } }

  SYMBOL historic_railway_car
