    POLYGON -0.8,-0.8 0.6,0.6 0.4,0.8 -1.0,-0.6 { AREA { color: @historicSymbolColor; } }
    POLYGON 0.8,-0.8 -0.6,0.6 -0.4,0.8 1.0,-0.6 { AREA { color: @historicSymbolColor; } }

  SYMBOL historic_wreck
