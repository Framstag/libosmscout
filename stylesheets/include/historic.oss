    RECTANGLE -0.5,-0.5 0.3 x 0.2 { AREA { color: @historicSymbolColor; } }
    RECTANGLE 0.0,-0.5 0.3 x 0.2 { AREA { color: @historicSymbolColor; } }
    RECTANGLE 0.5,-0.5 0.3 x 0.2 { AREA { color: @historicSymbolColor; } }
    RECTANGLE 0.7,-0.5 0.3 x 0.2 { AREA { color: @historicSymbolColor; } }

  SYMBOL historic_ruins
    // Broken wall fragments
    POLYGON -0.9,0.3 -0.3,0.3 -0.3,-0.5 -0.6,-0.5 -0.6,-0.1 -0.9,-0.1 { AREA { color: @historicSymbolColor; } }
    POLYGON 0.1,0.3 0.7,0.3 0.7,-0.3 0.4,-0.3 0.4,0.0 0.1,0.0 { AREA { color: @historicSymbolColor; } }

  SYMBOL historic_archaeological_site
