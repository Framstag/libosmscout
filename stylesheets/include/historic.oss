    RECTANGLE -0.12,-0.4 0.24 x 0.9 { AREA { color: @historicSymbolColor; } }
    // Capital
    RECTANGLE -0.25,-0.5 0.5 x 0.1 { AREA { color: @historicSymbolColor; } }
    // Base
    RECTANGLE -0.25,0.5 0.5 x 0.1 { AREA { color: @historicSymbolColor; } }

  SYMBOL historic_battlefield
