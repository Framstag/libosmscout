  SYMBOL man_made_telescope
    // Telescope
    RECTANGLE -0.5,-0.1 1.0 x 0.2 { AREA { color: @manMadeSymbolColor; } }
    // Mount
    RECTANGLE -0.1,0.1 0.2 x 0.4 { AREA { color: @manMadeSymbolColor; } }
    // Base
    RECTANGLE -0.3,0.5 0.6 x 0.1 { AREA { color: @manMadeSymbolColor; } }

  SYMBOL man_made_works
    // Factory building
    RECTANGLE -0.7,-0.2 1.4 x 0.5 { AREA { color: @manMadeSymbolColor; } }
    // Chimney
    RECTANGLE 0.3,-0.5 0.2 x 0.3 { AREA { color: @manMadeSymbolColor; } }
    // Windows
    RECTANGLE -0.5,0.0 0.2 x 0.2 { AREA { color: #ffffff; } }
    RECTANGLE -0.1,0.0 0.2 x 0.2 { AREA { color: #ffffff; } }

  SYMBOL man_made_kiln
    // Kiln
    CIRCLE 0,0 0.5 { AREA { color: @manMadeSymbolColor; } }
    // Opening
    RECTANGLE -0.2,0.1 0.4 x 0.3 { AREA { color: #ffffff; } }

  SYMBOL man_made_street_cabinet
    // Cabinet
    RECTANGLE -0.35,-0.4 0.7 x 0.8 { AREA { color: @manMadeSymbolColor; } }
    // Door line
    RECTANGLE -0.25,-0.3 0.5 x 0.6 { AREA.BORDER { color: @manMadeSymbolColor; width: 0.05mm; } }

  SYMBOL man_made_snow_cannon
    // Cannon
    RECTANGLE -0.5,-0.2 1.0 x 0.3 { AREA { color: @manMadeSymbolColor; } }
    // Nozzle
    RECTANGLE 0.4,-0.3 0.2 x 0.15 { AREA { color: @manMadeSymbolColor; } }
    // Snow
    CIRCLE 0.6,-0.5 0.15 { AREA { color: #ffffff; } }
    CIRCLE 0.75,-0.4 0.1 { AREA { color: #ffffff; } }

  SYMBOL man_made_telephone_box
    // Booth
    RECTANGLE -0.6,-0.7 1.2 x 1.4 { AREA.BORDER { color: @manMadeSymbolColor; width: 0.1mm; } }
    // Roof
    POLYGON -0.7,-0.7 0.7,-0.7 0,-0.95 { AREA { color: @manMadeSymbolColor; } }
    // Handset
    POLYGON 0.3,-0.2 -0.3,-0.2 -0.3,-0.05 -0.12,-0.05 -0.12,0.25 -0.3,0.25 -0.3,0.4 0.3,0.4 0.3,0.25 0.12,0.25 0.12,-0.05 0.3,-0.05 { AREA { color: @manMadeSymbolColor; } }

  SYMBOL man_made_fuel_pump
    // Fuel pump
    RECTANGLE -0.597,-0.996 1.195 x 1.792 { AREA.BORDER { color: @manMadeSymbolColor; width: 0.239mm; } }
    RECTANGLE -0.398,-0.697 0.796 x 0.398 { AREA { color: @manMadeSymbolColor; } }
    POLYGON 0.597,0.199 1.095,0.199 { AREA.BORDER { color: @manMadeSymbolColor; width: 0.239mm; } }
    POLYGON 1.095,0.199 1.095,0.697 { AREA.BORDER { color: @manMadeSymbolColor; width: 0.239mm; } }
    CIRCLE 1.095,0.796 0.159 { AREA { color: @manMadeSymbolColor; } }

  SYMBOL man_made_adit
    // Arch
    RECTANGLE -0.5,-0.2 0.4 x 0.5 { AREA { color: @manMadeSymbolColor; } }
    RECTANGLE 0.1,-0.2 0.4 x 0.5 { AREA { color: @manMadeSymbolColor; } }
    POLYGON -0.5,-0.2 0.5,-0.2 0,-0.6 { AREA { color: @manMadeSymbolColor; } }
    // Opening
    RECTANGLE -0.3,0.1 0.6 x 0.2 { AREA { color: #ffffff; } }

STYLE
 // -------------------------------------------------------
 //
 // Man made:
 // power, barrier
 //

 [MAG detail-] {
   [TYPE power_generator] AREA { color: #bca9a9; }

   [TYPE man_made_wastewater_plant] {
     AREA { color: @industrialColor; }
     AREA.BORDER { color: darken(@industrialColor, 0.3); width: 0.1mm; }
   }

   [TYPE man_made_works,
         man_made_water_works,
         man_made_pumping_station,
         man_made_monitoring_station] {
     AREA { color: @industrialColor; }
     AREA.BORDER { color: darken(@industrialColor, 0.3); width: 0.1mm; }
   }

   [TYPE man_made_storage_tank,
         man_made_silo,
         man_made_bunker_silo,
         man_made_gasometer,
         man_made_reservoir_covered] {
     AREA { color: lighten(@industrialColor, 0.2); }
     AREA.BORDER { color: darken(@industrialColor, 0.3); width: 0.1mm; }
   }

   [TYPE man_made_clearcut] {
     AREA { color: #d9d0c0; }
     AREA.BORDER { color: #b0a890; width: 0.1mm; }
   }

   [TYPE man_made_heap,
         man_made_spoil_heap,
         man_made_tailings_pond] {
     AREA { color: #d8cbb8; }
     AREA.BORDER { color: #b0a080; width: 0.1mm; }
   }

   [TYPE man_made_breakwater,
         man_made_groyne,
         man_made_dyke,
         man_made_quay] {
     AREA { color: #ffffff; }
     AREA.BORDER { color: #c0c0c0; width: 0.1mm; }
   }

   [TYPE man_made_courtyard] {
     AREA { color: #f0f0e8; }
     AREA.BORDER { color: #c8c8c0; width: 0.1mm; }
   }

   [TYPE man_made_bioswale] {
     AREA { color: #c8e0c0; }
     AREA.BORDER { color: #90b080; width: 0.1mm; }
   }

   [TYPE man_made_tunnel] {
     AREA { color: #d0d0d0; }
     AREA.BORDER { color: #909090; width: 0.1mm; }
   }

   [TYPE man_made_clarifier] {
     AREA { color: #c8d8e0; }
     AREA.BORDER { color: #90a8b8; width: 0.1mm; }
   }

 }

 [MAG close-] {
   [TYPE power_line] WAY { color: #6f6f6f; displayWidth: 0.08mm; width: 4m; }
   [TYPE power_minor_line] WAY { color: #6f6f6f; displayWidth: 0.05mm; width: 2m; }
   [TYPE power_cable] WAY { color: #6f6f6f; displayWidth: 0.05mm; width: 2m; }
   [TYPE power_circuit] WAY { color: #6f6f6f; displayWidth: 0.05mm; width: 2m; }
   [TYPE power_tower] NODE.ICON { symbol: power_tower; }
   [TYPE power_pole] NODE.ICON { symbol: power_pole; }
   [TYPE power_catenary_mast] NODE.ICON { symbol: power_catenary_mast; }
   [TYPE power_portal] NODE.ICON { symbol: power_portal; }
   [TYPE power_transformer] NODE.ICON { symbol: power_transformer; }
   [TYPE power_switch] NODE.ICON { symbol: power_switch; }
   [TYPE power_plant] NODE.ICON { symbol: power_plant; }
   [TYPE power_heliostat] NODE.ICON { symbol: power_heliostat; }
   [TYPE power_catenary_portal,
         power_terminal,
         power_connection,
         power_insulator,
         power_compensator,
         power_inverter,
         power_switchgear,
         power_converter] NODE.ICON { symbol: power_pole; }

   [TYPE man_made_pier] {
     [SIZE 5m 0.1mm:3px<] WAY {color: #ffffff; width: 5.0m;}
     [SIZE 5m <0.1mm:3px] WAY {color: #ffffff; displayWidth: 0.1mm;}
     AREA { color: #ffffff; }
   }

   [TYPE man_made_breakwater,
         man_made_groyne,
         man_made_quay] {
     [SIZE 5m 0.1mm:3px<] WAY {color: #ffffff; width: 5.0m;}
     [SIZE 5m <0.1mm:3px] WAY {color: #ffffff; displayWidth: 0.1mm;}
   }

   [TYPE man_made_dyke] {
     [SIZE 5m 0.1mm:3px<] WAY {color: @damColor; width: 5.0m;}
     [SIZE 5m <0.1mm:3px] WAY {color: @damColor; displayWidth: 0.1mm;}
   }

   [TYPE man_made_cutline] WAY {color: #b0a890; displayWidth: 0.05mm; width: 1m; dash: 2,2;}
   [TYPE man_made_pipeline] WAY {color: #6f6f6f; displayWidth: 0.05mm; width: 2m; dash: 4,2;}
   [TYPE man_made_goods_conveyor] WAY {color: #6f6f6f; displayWidth: 0.08mm; width: 3m;}
   [TYPE man_made_cooling] WAY {color: #6f6f6f; displayWidth: 0.08mm; width: 3m;}
   [TYPE man_made_snow_fence] WAY {color: #aaaaaa; displayWidth: 0.1mm;}
   [TYPE man_made_embankment] WAY {color: #8a7a6a; displayWidth: 0.1mm; width: 3m;}
   [TYPE man_made_advertising] WAY {color: #6f6f6f; displayWidth: 0.05mm; width: 1m;}

   [TYPE waterway_dam] {
     AREA { color: @damColor; }
     WAY { color: @damColor; width: 4.0m; }
   }
 }

 [MAG closer-] {

   [TYPE barrier_wall] WAY {color: @wallColor; displayWidth: 0.1mm; width: 0.5m;}
   [TYPE barrier_retaining_wall] WAY {color: lighten(@wallColor, 0.5); displayWidth: 0.12mm; width: 0.5m;}
   [TYPE barrier_kerb] WAY {color: lighten(@wallColor, 0.5); displayWidth: 0.12mm; width: 0.5m;}
   [TYPE barrier_jersey_barrier] WAY {color: @wallColor; displayWidth: 0.1mm; width: 0.5m;}

   [TYPE barrier_city_wall] WAY {color: @wallColor; displayWidth: 0.1mm; width: 0.5m;}
   [TYPE barrier_city_wall] WAY#decor {color: @wallColor;
             dash: 1,5; displayOffset: 0.09mm; offset: 0.5m; joinCap: butt; endCap: butt;
             displayWidth: 0.1mm; width: 0.5m;
   }
   [TYPE barrier_wall]           {
     AREA {color: lighten(@wallColor, 0.5); }
     AREA.BORDER {color: @wallColor; width: 0.1mm; }
   }

   [TYPE barrier_retaining_wall] {
     AREA {color: lighten(@wallColor, 0.5); }
     AREA.BORDER {color: @wallColor; width: 0.1mm; }
   }

   [TYPE barrier_city_wall] {
     AREA {color: lighten(@wallColor, 0.5);}
     AREA.BORDER {color: @wallColor; width: 0.3mm; }
   }
 }

