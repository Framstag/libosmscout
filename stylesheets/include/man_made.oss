OSS
CONST
  COLOR amenitySymbolColor          = darken(@amenityColor, 0.4);
  COLOR barrierSymbolColor          = #555555;
  COLOR manMadeSymbolColor         = #555555;

  SYMBOL barrier_kerb
    // Low curb
    RECTANGLE -1.2,-0.15 2.4 x 0.3 { AREA { color: @barrierSymbolColor; } }

  SYMBOL barrier_chain
    // Posts
    RECTANGLE -1.2,-0.5 0.2 x 1.0 { AREA { color: @barrierSymbolColor; } }
    RECTANGLE 1.0,-0.5 0.2 x 1.0 { AREA { color: @barrierSymbolColor; } }
    // Chain links
    CIRCLE -0.6,0 0.12 { AREA { color: @barrierSymbolColor; } }
    CIRCLE -0.2,0 0.12 { AREA { color: @barrierSymbolColor; } }
    CIRCLE 0.2,0 0.12 { AREA { color: @barrierSymbolColor; } }
    CIRCLE 0.6,0 0.12 { AREA { color: @barrierSymbolColor; } }

  SYMBOL barrier_jersey_barrier
    // Trapezoid block
    POLYGON -1.2,0.3 1.2,0.3 0.9,-0.3 -0.9,-0.3 { AREA { color: @barrierSymbolColor; } }

  SYMBOL barrier_log
    // Log
    RECTANGLE -1.2,-0.25 2.4 x 0.5 { AREA { color: @barrierSymbolColor; } }
    CIRCLE -1.2,0 0.25 { AREA { color: @barrierSymbolColor; } }
    CIRCLE 1.2,0 0.25 { AREA { color: @barrierSymbolColor; } }

  SYMBOL barrier_rope
    // Posts
    RECTANGLE -1.2,-0.5 0.2 x 1.0 { AREA { color: @barrierSymbolColor; } }
    RECTANGLE 1.0,-0.5 0.2 x 1.0 { AREA { color: @barrierSymbolColor; } }
    // Sagging rope
    CIRCLE -0.5,0.15 0.1 { AREA { color: @barrierSymbolColor; } }
    CIRCLE 0,0.25 0.1 { AREA { color: @barrierSymbolColor; } }
    CIRCLE 0.5,0.15 0.1 { AREA { color: @barrierSymbolColor; } }

  SYMBOL barrier_avalanche_protection
    // Fence rail
    RECTANGLE -1.2,-0.15 2.4 x 0.2 { AREA { color: @barrierSymbolColor; } }
    // Posts
    RECTANGLE -0.8,0.1 0.15 x 0.6 { AREA { color: @barrierSymbolColor; } }
    RECTANGLE 0.65,0.1 0.15 x 0.6 { AREA { color: @barrierSymbolColor; } }

  SYMBOL barrier_swing_gate
    // Pivot
    CIRCLE -1.0,0 0.15 { AREA { color: @barrierSymbolColor; } }
    // Bar
    RECTANGLE -0.85,-0.1 1.7 x 0.2 { AREA { color: @barrierSymbolColor; } }

  SYMBOL barrier_wicket_gate
    // Fence posts
    RECTANGLE -1.2,-0.4 0.2 x 0.8 { AREA { color: @barrierSymbolColor; } }
    RECTANGLE 1.0,-0.4 0.2 x 0.8 { AREA { color: @barrierSymbolColor; } }
    // Small gate
    RECTANGLE -0.3,-0.3 0.6 x 0.6 { AREA { color: @barrierSymbolColor; } }

  SYMBOL barrier_kissing_gate
    // Enclosure
    RECTANGLE -0.9,-0.6 1.2 x 1.2 { AREA.BORDER { color: @barrierSymbolColor; width: 0.1mm; } }
    // V-shaped gate
    POLYGON 0.3,-0.6 0.9,0 0.3,0.6 { AREA { color: @barrierSymbolColor; } }

  SYMBOL barrier_height_restrictor
    // Bar
    RECTANGLE -1.2,-0.1 2.4 x 0.2 { AREA { color: @barrierSymbolColor; } }
    // Height arrow
    RECTANGLE -0.1,-0.5 0.2 x 0.4 { AREA { color: @barrierSymbolColor; } }
    POLYGON 0,-0.5 -0.25,-0.7 0.25,-0.7 { AREA { color: @barrierSymbolColor; } }

  SYMBOL barrier_turnstile
    // Center
    CIRCLE 0,0 0.15 { AREA { color: @barrierSymbolColor; } }
    // Rotating bars
    RECTANGLE -0.9,-0.1 1.8 x 0.2 { AREA { color: @barrierSymbolColor; } }
    RECTANGLE -0.1,-0.9 0.2 x 1.8 { AREA { color: @barrierSymbolColor; } }

  SYMBOL barrier_sliding_gate
    // Gate
    RECTANGLE -1.2,-0.3 1.6 x 0.6 { AREA { color: @barrierSymbolColor; } }
    // Slide arrow
    POLYGON 0.9,-0.5 0.6,-0.3 0.9,-0.1 { AREA { color: @barrierSymbolColor; } }

  SYMBOL barrier_hampshire_gate
    // Posts
    RECTANGLE -1.2,-0.3 0.2 x 0.6 { AREA { color: @barrierSymbolColor; } }
    RECTANGLE 1.0,-0.3 0.2 x 0.6 { AREA { color: @barrierSymbolColor; } }
    // Wire fence section
    RECTANGLE -0.5,-0.2 1.0 x 0.1 { AREA { color: @barrierSymbolColor; } }
    RECTANGLE -0.5,0.1 1.0 x 0.1 { AREA { color: @barrierSymbolColor; } }

  SYMBOL barrier_border_control
    // Flag pole
    RECTANGLE -0.1,-0.9 0.2 x 1.8 { AREA { color: @barrierSymbolColor; } }
    // Flag
    POLYGON 0.1,-0.9 0.9,-0.7 0.1,-0.5 { AREA { color: @barrierSymbolColor; } }

  SYMBOL barrier_planter
    // Box
    RECTANGLE -0.8,0.1 1.6 x 0.5 { AREA { color: @barrierSymbolColor; } }
    // Stem
    RECTANGLE -0.1,-0.5 0.2 x 0.6 { AREA { color: @barrierSymbolColor; } }
    // Foliage
    CIRCLE 0,-0.6 0.3 { AREA { color: @barrierSymbolColor; } }

  SYMBOL barrier_debris
    // Pile
    CIRCLE -0.4,0.2 0.35 { AREA { color: @barrierSymbolColor; } }
    CIRCLE 0.1,0.25 0.3 { AREA { color: @barrierSymbolColor; } }
    CIRCLE 0.5,0.15 0.25 { AREA { color: @barrierSymbolColor; } }

  SYMBOL barrier_full_height_turnstile
    // Cage
    CIRCLE 0,0 0.9 { AREA.BORDER { color: @barrierSymbolColor; width: 0.1mm; } }
    // Center
    CIRCLE 0,0 0.15 { AREA { color: @barrierSymbolColor; } }
    // Rotating bars
    RECTANGLE -0.9,-0.1 1.8 x 0.2 { AREA { color: @barrierSymbolColor; } }
    RECTANGLE -0.1,-0.9 0.2 x 1.8 { AREA { color: @barrierSymbolColor; } }

  SYMBOL man_made_wastewater_plant
    CIRCLE 0,0 1.125 { AREA.BORDER { color: @amenitySymbolColor; width: 0.241mm; } }
    CIRCLE 0,0 0.482 { AREA { color: @amenitySymbolColor; } }

  SYMBOL power_tower
    CIRCLE 0,0 1.125 { AREA.BORDER { color: @amenitySymbolColor; width: 0.245mm; } }
    POLYGON -1.125,-1.125 1.125,1.125 { AREA.BORDER { color: @amenitySymbolColor; width: 0.245mm; } }
    POLYGON -1.125,1.125 1.125,-1.125 { AREA.BORDER { color: @amenitySymbolColor; width: 0.245mm; } }

  SYMBOL power_pole
    CIRCLE 0,0 1.125 { AREA { color: @amenitySymbolColor; } }

  SYMBOL power_catenary_mast
    // Mast
    RECTANGLE -0.15,-0.5 0.3 x 0.8 { AREA { color: @amenitySymbolColor; } }
    // Cross-arm holding the contact wire
    RECTANGLE -0.6,0.3 1.2 x 0.2 { AREA { color: @amenitySymbolColor; } }

  SYMBOL power_portal
    // Left leg
    RECTANGLE -0.7,-0.5 0.2 x 1.0 { AREA { color: @amenitySymbolColor; } }
    // Right leg
    RECTANGLE 0.5,-0.5 0.2 x 1.0 { AREA { color: @amenitySymbolColor; } }
    // Crossarm
    RECTANGLE -0.7,0.4 1.4 x 0.2 { AREA { color: @amenitySymbolColor; } }

  SYMBOL power_transformer
    // Drum
    RECTANGLE -0.6,-0.4 1.2 x 0.8 { AREA { color: @amenitySymbolColor; } }
    CIRCLE 0,0 0.3 { AREA { color: #ffffff; } }

  SYMBOL power_switch
    // Box
    RECTANGLE -0.5,-0.35 1.0 x 0.7 { AREA { color: @amenitySymbolColor; } }
    // Lever
    POLYGON -0.1,-0.35 0.3,-0.6 { AREA { color: @amenitySymbolColor; } }

  SYMBOL power_plant
    // Building
    RECTANGLE -0.7,-0.3 1.4 x 0.6 { AREA { color: @amenitySymbolColor; } }
    // Chimney
    RECTANGLE 0.3,-0.6 0.25 x 0.4 { AREA { color: @amenitySymbolColor; } }

  SYMBOL power_heliostat
    // Tilted mirror
    POLYGON -0.6,0.1 0.6,-0.1 0.6,0.3 -0.6,0.5 { AREA { color: @amenitySymbolColor; } }
    // Support
    RECTANGLE -0.05,-0.5 0.1 x 0.5 { AREA { color: @amenitySymbolColor; } }

  SYMBOL man_made_tower
    // Tower
    RECTANGLE -0.35,-0.6 0.7 x 1.1 { AREA { color: @manMadeSymbolColor; } }
    // Roof
    POLYGON -0.45,-0.6 0.45,-0.6 0,-1.0 { AREA { color: @manMadeSymbolColor; } }
    // Door
    RECTANGLE -0.12,0.3 0.24 x 0.2 { AREA { color: #ffffff; } }

  SYMBOL man_made_communications_tower
    // Lattice tower
    POLYGON -0.3,0.9 0.3,0.9 0,-0.9 { AREA { color: @manMadeSymbolColor; } }
    // Crossbars
    RECTANGLE -0.3,0.5 0.6 x 0.1 { AREA { color: @manMadeSymbolColor; } }
    RECTANGLE -0.2,0.0 0.4 x 0.1 { AREA { color: @manMadeSymbolColor; } }
    RECTANGLE -0.1,-0.5 0.2 x 0.1 { AREA { color: @manMadeSymbolColor; } }
    // Antenna
    RECTANGLE -0.05,-1.1 0.1 x 0.2 { AREA { color: @manMadeSymbolColor; } }

  SYMBOL man_made_mast
    // Mast
    RECTANGLE -0.1,-0.9 0.2 x 1.8 { AREA { color: @manMadeSymbolColor; } }
    // Crossbars
    RECTANGLE -0.5,-0.5 1.0 x 0.1 { AREA { color: @manMadeSymbolColor; } }
    RECTANGLE -0.4,-0.1 0.8 x 0.1 { AREA { color: @manMadeSymbolColor; } }

  SYMBOL man_made_water_tower
    // Legs
    RECTANGLE -0.5,-0.2 0.15 x 0.9 { AREA { color: @manMadeSymbolColor; } }
    RECTANGLE 0.35,-0.2 0.15 x 0.9 { AREA { color: @manMadeSymbolColor; } }
    // Tank
    RECTANGLE -0.6,-0.4 1.2 x 0.6 { AREA { color: @manMadeSymbolColor; } }
    // Roof
    POLYGON -0.7,-0.4 0.7,-0.4 0,-0.8 { AREA { color: @manMadeSymbolColor; } }

  SYMBOL man_made_lighthouse
    // Tower
    RECTANGLE -0.3,-0.5 0.6 x 1.0 { AREA { color: @manMadeSymbolColor; } }
    // Lantern
    RECTANGLE -0.4,-0.6 0.8 x 0.2 { AREA { color: @manMadeSymbolColor; } }
    // Roof
    POLYGON -0.45,-0.6 0.45,-0.6 0,-0.9 { AREA { color: @manMadeSymbolColor; } }
    // Light rays
    POLYGON 0.4,-0.5 0.9,-0.7 0.9,-0.3 { AREA { color: @manMadeSymbolColor; } }
    POLYGON -0.4,-0.5 -0.9,-0.7 -0.9,-0.3 { AREA { color: @manMadeSymbolColor; } }

  SYMBOL man_made_windmill
    // Building
    RECTANGLE -0.4,-0.3 0.8 x 0.8 { AREA { color: @manMadeSymbolColor; } }
    // Roof
    POLYGON -0.5,-0.3 0.5,-0.3 0,-0.7 { AREA { color: @manMadeSymbolColor; } }
    // Sails
    RECTANGLE -0.05,-0.9 0.1 x 1.2 { AREA { color: @manMadeSymbolColor; } }
    RECTANGLE -0.6,-0.05 1.2 x 0.1 { AREA { color: @manMadeSymbolColor; } }

  SYMBOL man_made_watermill
    // Building
    RECTANGLE -0.5,-0.3 1.0 x 0.7 { AREA { color: @manMadeSymbolColor; } }
    // Roof
    POLYGON -0.6,-0.3 0.6,-0.3 0,-0.7 { AREA { color: @manMadeSymbolColor; } }
    // Water wheel
    CIRCLE 0.55,0.1 0.3 { AREA.BORDER { color: @manMadeSymbolColor; width: 0.1mm; } }
    CIRCLE 0.55,0.1 0.08 { AREA { color: @manMadeSymbolColor; } }

  SYMBOL man_made_windpump
    // Tower
    POLYGON -0.2,0.8 0.2,0.8 0,-0.2 { AREA { color: @manMadeSymbolColor; } }
    // Fan
    CIRCLE 0,-0.2 0.35 { AREA.BORDER { color: @manMadeSymbolColor; width: 0.1mm; } }
    RECTANGLE -0.3,-0.2 0.6 x 0.08 { AREA { color: @manMadeSymbolColor; } }
    RECTANGLE -0.08,-0.4 0.08 x 0.4 { AREA { color: @manMadeSymbolColor; } }

  SYMBOL man_made_cross
    // Cross
    RECTANGLE -0.1,-0.9 0.2 x 1.8 { AREA { color: @manMadeSymbolColor; } }
    RECTANGLE -0.5,-0.5 1.0 x 0.2 { AREA { color: @manMadeSymbolColor; } }

  SYMBOL man_made_cairn
    // Stone pile
    POLYGON -0.5,0.4 0.5,0.4 0,-0.4 { AREA { color: @manMadeSymbolColor; } }
    POLYGON -0.3,0.1 0.3,0.1 0,-0.5 { AREA { color: lighten(@manMadeSymbolColor, 0.3); } }

  SYMBOL man_made_column
    // Column
    RECTANGLE -0.15,-0.5 0.3 x 1.0 { AREA { color: @manMadeSymbolColor; } }
    // Capital
    RECTANGLE -0.25,-0.6 0.5 x 0.1 { AREA { color: @manMadeSymbolColor; } }
    // Base
    RECTANGLE -0.25,0.5 0.5 x 0.1 { AREA { color: @manMadeSymbolColor; } }

  SYMBOL man_made_stupa
    // Dome
    CIRCLE 0,-0.1 0.5 { AREA { color: @manMadeSymbolColor; } }
    // Base
    RECTANGLE -0.6,0.3 1.2 x 0.15 { AREA { color: @manMadeSymbolColor; } }
    // Spire
    RECTANGLE -0.05,-0.7 0.1 x 0.3 { AREA { color: @manMadeSymbolColor; } }
    POLYGON -0.05,-0.7 0.05,-0.7 0,-0.9 { AREA { color: @manMadeSymbolColor; } }

  SYMBOL man_made_ceremonial_gate
    // Pillars
    RECTANGLE -0.6,-0.5 0.4 x 1.0 { AREA { color: @manMadeSymbolColor; } }
    RECTANGLE 0.2,-0.5 0.4 x 1.0 { AREA { color: @manMadeSymbolColor; } }
    // Lintel
    RECTANGLE -0.7,-0.8 1.4 x 0.3 { AREA { color: @manMadeSymbolColor; } }
    // Roof
    POLYGON -0.8,-0.8 0.8,-0.8 0,-1.1 { AREA { color: @manMadeSymbolColor; } }

  SYMBOL man_made_chimney
    // Chimney
    RECTANGLE -0.2,-0.9 0.4 x 1.8 { AREA { color: @manMadeSymbolColor; } }
    // Smoke
    CIRCLE 0,-0.9 0.15 { AREA { color: #aaaaaa; } }
    CIRCLE 0.1,-1.1 0.2 { AREA { color: #aaaaaa; } }

  SYMBOL man_made_flare
    // Stack
    RECTANGLE -0.15,-0.8 0.3 x 1.0 { AREA { color: @manMadeSymbolColor; } }
    // Flame
    POLYGON 0,-0.9 -0.2,-0.6 0.2,-0.6 { AREA { color: #ff6600; } }

  SYMBOL man_made_crane
    // Mast
    RECTANGLE -0.1,-0.8 0.2 x 1.6 { AREA { color: @manMadeSymbolColor; } }
    // Jib
    RECTANGLE -0.1,-0.8 1.2 x 0.15 { AREA { color: @manMadeSymbolColor; } }
    // Counterweight
    RECTANGLE -0.5,-0.65 0.3 x 0.3 { AREA { color: @manMadeSymbolColor; } }
    // Hook
    RECTANGLE 0.9,-0.5 0.1 x 0.3 { AREA { color: @manMadeSymbolColor; } }

  SYMBOL man_made_gasometer
    // Gas holder
    RECTANGLE -0.6,-0.5 1.2 x 1.0 { AREA { color: @manMadeSymbolColor; } }
    // Top
    POLYGON -0.7,-0.5 0.7,-0.5 0,-0.7 { AREA { color: @manMadeSymbolColor; } }
    // Lattice lines
    RECTANGLE -0.6,-0.3 1.2 x 0.05 { AREA { color: #ffffff; } }
    RECTANGLE -0.6,0.0 1.2 x 0.05 { AREA { color: #ffffff; } }
    RECTANGLE -0.6,0.3 1.2 x 0.05 { AREA { color: #ffffff; } }

  SYMBOL man_made_storage_tank
    // Tank
    RECTANGLE -0.6,-0.4 1.2 x 0.8 { AREA { color: @manMadeSymbolColor; } }
    // Dome top
    POLYGON -0.6,-0.4 0.6,-0.4 0,-0.7 { AREA { color: @manMadeSymbolColor; } }
    // Highlight
    RECTANGLE -0.4,-0.3 0.2 x 0.6 { AREA { color: lighten(@manMadeSymbolColor, 0.4); } }

  SYMBOL man_made_silo
    // Silo
    RECTANGLE -0.35,-0.6 0.7 x 1.2 { AREA { color: @manMadeSymbolColor; } }
    // Dome top
    POLYGON -0.35,-0.6 0.35,-0.6 0,-0.8 { AREA { color: @manMadeSymbolColor; } }
    // Highlight
    RECTANGLE -0.2,-0.5 0.15 x 1.0 { AREA { color: lighten(@manMadeSymbolColor, 0.4); } }

  SYMBOL man_made_flagpole
    // Pole
    RECTANGLE -0.05,-0.9 0.1 x 1.8 { AREA { color: @manMadeSymbolColor; } }
    // Flag
    POLYGON 0.05,-0.9 0.7,-0.75 0.05,-0.6 { AREA { color: @manMadeSymbolColor; } }

  SYMBOL man_made_beacon
    // Beacon
    RECTANGLE -0.2,-0.6 0.4 x 1.2 { AREA { color: @manMadeSymbolColor; } }
    // Light
    CIRCLE 0,-0.7 0.2 { AREA { color: #ff6600; } }

  SYMBOL man_made_buoy
    // Buoy
    CIRCLE 0,0 0.4 { AREA { color: @manMadeSymbolColor; } }
    // Top light
    RECTANGLE -0.05,-0.5 0.1 x 0.2 { AREA { color: @manMadeSymbolColor; } }
    CIRCLE 0,-0.6 0.12 { AREA { color: #ff6600; } }

  SYMBOL man_made_dolphin
    // Mooring post
    RECTANGLE -0.2,-0.5 0.4 x 1.0 { AREA { color: @manMadeSymbolColor; } }
    // Cap
    RECTANGLE -0.3,-0.6 0.6 x 0.15 { AREA { color: @manMadeSymbolColor; } }

  SYMBOL man_made_antenna
    // Antenna
    RECTANGLE -0.1,-0.9 0.2 x 1.8 { AREA { color: @manMadeSymbolColor; } }
    // Elements
    RECTANGLE -0.5,-0.6 1.0 x 0.1 { AREA { color: @manMadeSymbolColor; } }
    RECTANGLE -0.4,-0.2 0.8 x 0.1 { AREA { color: @manMadeSymbolColor; } }
    RECTANGLE -0.3,0.2 0.6 x 0.1 { AREA { color: @manMadeSymbolColor; } }

  SYMBOL man_made_satellite_dish
    // Dish
    CIRCLE 0,0 0.5 { AREA.BORDER { color: @manMadeSymbolColor; width: 0.1mm; } }
    // Feed horn
    RECTANGLE -0.05,-0.05 0.1 x 0.1 { AREA { color: @manMadeSymbolColor; } }
    // Support
    RECTANGLE -0.05,0.4 0.1 x 0.3 { AREA { color: @manMadeSymbolColor; } }

  SYMBOL man_made_utility_pole
    // Pole
    RECTANGLE -0.08,-0.9 0.16 x 1.8 { AREA { color: @manMadeSymbolColor; } }
    // Crossarm
    RECTANGLE -0.5,-0.6 1.0 x 0.1 { AREA { color: @manMadeSymbolColor; } }

  SYMBOL man_made_manhole
    // Manhole cover
    CIRCLE 0,0 0.4 { AREA.BORDER { color: @manMadeSymbolColor; width: 0.1mm; } }
    RECTANGLE -0.3,0 0.6 x 0.08 { AREA { color: @manMadeSymbolColor; } }
    RECTANGLE 0,-0.3 0.08 x 0.6 { AREA { color: @manMadeSymbolColor; } }

  SYMBOL man_made_survey_point
    // Survey point
    POLYGON 0,-0.5 0.5,0.3 -0.5,0.3 { AREA { color: @manMadeSymbolColor; } }
    // Center dot
    CIRCLE 0,0.05 0.1 { AREA { color: #ffffff; } }

  SYMBOL man_made_surveillance
    // Camera
    RECTANGLE -0.5,-0.2 1.0 x 0.4 { AREA { color: @manMadeSymbolColor; } }
    // Lens
    CIRCLE 0.35,0 0.12 { AREA { color: #ffffff; } }
    // Mount
