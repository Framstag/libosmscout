    RECTANGLE -0.4,-0.5 0.8 x 0.1 { AREA { color: @manMadeSymbolColor; } }
    RECTANGLE -0.4,0.4 0.8 x 0.1 { AREA { color: @manMadeSymbolColor; } }
    RECTANGLE -0.4,-0.5 0.1 x 1.0 { AREA { color: @manMadeSymbolColor; } }
