OSS
CONST
  COLOR amenitySymbolColor          = darken(@amenityColor, 0.4);

  SYMBOL man_made_wastewater_plant
    CIRCLE 0,0 1.125 { AREA.BORDER { color: @amenitySymbolColor; width: 0.241mm; } }
    CIRCLE 0,0 0.482 { AREA { color: @amenitySymbolColor; } }

  SYMBOL power_tower
    CIRCLE 0,0 1.125 { AREA.BORDER { color: @amenitySymbolColor; width: 0.245mm; } }
    POLYGON -1.125,-1.125 1.125,1.125 { AREA.BORDER { color: @amenitySymbolColor; width: 0.245mm; } }
    POLYGON -1.125,1.125 1.125,-1.125 { AREA.BORDER { color: @amenitySymbolColor; width: 0.245mm; } }

  SYMBOL power_pole
    CIRCLE 0,0 1.125 { AREA { color: @amenitySymbolColor; } }

STYLE
 // -------------------------------------------------------
 //
 // Man made:
 // power, barrier
 //

 [MAG detail-] {
   [TYPE power_generator] AREA { color: #bca9a9; }

   [TYPE man_made_wastewater_plant] {
     AREA { color: @industrialColor; }
     AREA.BORDER { color: darken(@industrialColor, 0.3); width: 0.1mm; }
   }

 }

 [MAG close-] {
   [TYPE power_line] WAY { color: #6f6f6f; displayWidth: 0.08mm; width: 4m; }
   [TYPE power_minor_line] WAY { color: #6f6f6f; displayWidth: 0.05mm; width: 2m; }
   [TYPE power_tower] NODE.ICON { symbol: power_tower; }
   [TYPE power_pole] NODE.ICON { symbol: power_pole; }

   [TYPE man_made_pier] {
     [SIZE 5m 0.1mm:3px<] WAY {color: #ffffff; width: 5.0m;}
     [SIZE 5m <0.1mm:3px] WAY {color: #ffffff; displayWidth: 0.1mm;}
     AREA { color: #ffffff; }
   }

   [TYPE waterway_dam] {
     AREA { color: @damColor; }
     WAY { color: @damColor; width: 4.0m; }
   }
 }

 [MAG closer-] {

   [TYPE barrier_wall] WAY {color: @wallColor; displayWidth: 0.1mm; width: 0.5m;}
   [TYPE barrier_retaining_wall] WAY {color: lighten(@wallColor, 0.5); displayWidth: 0.12mm; width: 0.5m;}

   [TYPE barrier_city_wall] WAY {color: @wallColor; displayWidth: 0.1mm; width: 0.5m;}
   [TYPE barrier_city_wall] WAY#decor {color: @wallColor;
             dash: 1,5; displayOffset: 0.09mm; offset: 0.5m; joinCap: butt; endCap: butt;
             displayWidth: 0.1mm; width: 0.5m;
   }
   [TYPE barrier_wall]           {
     AREA {color: lighten(@wallColor, 0.5); }
     AREA.BORDER {color: @wallColor; width: 0.1mm; }
   }

   [TYPE barrier_retaining_wall] {
     AREA {color: lighten(@wallColor, 0.5); }
     AREA.BORDER {color: @wallColor; width: 0.1mm; }
   }

   [TYPE barrier_city_wall] {
     AREA {color: lighten(@wallColor, 0.5);}
     AREA.BORDER {color: @wallColor; width: 0.3mm; }
   }
 }

 [MAG veryClose-] {

   [TYPE man_made_wastewater_plant] NODE.ICON { symbol: man_made_wastewater_plant; }

   [TYPE barrier_fence] {
      WAY {color: #aaaaaa; displayWidth: 0.1mm;}
      AREA.BORDER {color: #aaaaaa; width: 0.1mm;}
   }
 }

END
