OSS

CONST
  // Active route colours, per presentation (the flag the clients push, and the default of
  // every style sheet that includes this module).
  // Daylight: a translucent violet fill over an OPAQUE, wider, magenta-leaning violet casing.
  // The casing is opaque AND wider than the fill (2.2mm vs 1.5mm) on purpose: it covers the whole
  // fill footprint, so the composited centre is "fill over casing" and does NOT depend on the road
  // underneath. Way labels are drawn after way fills and carry no halo, so a black street label
  // reads at 5.14:1 on that centre, where the opaque violet it replaced gave it only 2.56:1. A
  // translucent fill over a *dark* casing would darken the centre instead and re-break the label.
  // No road class fill of these style sheets uses a violet hue (the only violet hues in the road
  // styles are the bus stop marker and the bus symbol, both small point markers), and the casing
  // sits on the magenta side of the purple ramp, darker than the composited centre, so the rim
  // still reads as a border and stays visible on white residential roads.
  // Dark presentation: the previous red fill with a white casing, which already contrasts with the
  // darkened map.
  // NOTE: hex literals must be lowercase - Color::FromHexString only accepts 0-9a-f.
  IF daylight {
    COLOR routeColor          = #ba68c8d9; // violet, 85 percent alpha
    COLOR routeCasingColor    = #6a1b9a;
  }
  ELSE {
    COLOR routeColor          = #ff000088;
    COLOR routeCasingColor    = #ffffff;
  }
  COLOR routeStartColor      = #00aa00;
  COLOR routeEndColor        = #ff0000;
  COLOR favoriteMarkerColor  = #ff8800;
  COLOR favoriteBorderColor  = #ffffff;
  COLOR searchMarkerColor    = #ff00ff;
  COLOR searchBorderColor    = @favoriteBorderColor;
  COLOR trackColor           = #0088ff;
SYMBOL route_start
  CIRCLE 0,0 0.9 {
    AREA { color: @routeStartColor; }
    AREA.BORDER { color: #ffffff; width: 0.15mm; }
  }

SYMBOL route_end
  CIRCLE 0,0 0.9 {
    AREA { color: @routeEndColor; }
    AREA.BORDER { color: #ffffff; width: 0.15mm; }
  }

SYMBOL favorite_marker
  CIRCLE 0,0 1.1 {
    AREA { color: @favoriteMarkerColor; }
    AREA.BORDER { color: @favoriteBorderColor; width: 0.3mm; }
  }

SYMBOL search_marker
  CIRCLE 0,0 1.4 {
    AREA { color: @searchMarkerColor; }
    AREA.BORDER { color: @searchBorderColor; width: 0.35mm; }
  }

STYLE
  [MAG world-] {
    // Active route: a wide casing stroke under the fill so the route is bordered on both
    // sides and visible on any road color, including red primary roads. The outline is drawn
    // first (lower priority). Colors come from the presentation branch in CONST above
    // (daylight violet, dark presentation red + white).
    [TYPE _route] WAY#outline { color: @routeCasingColor; displayWidth: 2.2mm; width: 8m; priority: 99; }
    [TYPE _route] WAY {color: @routeColor; displayWidth: 1.5mm; width: 6m; priority: 100; }

    // Imported GPX track. Rendered as a thinner blue polyline so it is
    // distinguishable from the active route. Visible from city zoom upward.
    [MAG city-] {
      [TYPE _track] WAY {color: @trackColor; displayWidth: 0.8mm; width: 4m; priority: 90; }
    }

    // Route start/end markers. Visible from city zoom upward so they do not
    // clutter the view at low magnification.
    [MAG city-] {
      [TYPE _route_start] NODE.ICON { symbol: route_start; }
      [TYPE _route_end]   NODE.ICON { symbol: route_end;   }
    }

    // Favorite and search-selection markers are rendered a bit larger and stay
    // visible from city zoom upward (the AA map starts at city zoom — keeping
    // them at [MAG detail-] would fall back to the default grey node marker).
    [MAG city-] {
      [TYPE _favorite]        NODE.ICON { symbol: favorite_marker; priority: 200; }
      [TYPE _search_selected] NODE.ICON { symbol: search_marker; priority: 250; }
    }
  }

END
