OSS

CONST
  // Active route colors, per presentation (the flag both surfaces push).
  // Daylight: opaque violet with a dark violet casing — no road class of the
  // daylight stylesheet uses a violet hue, and a dark casing stays visible on
  // white residential roads where the former white casing disappeared.
  // Dark presentation: unchanged red fill with a white casing.
  // NOTE: hex literals must be lowercase — Color::FromHexString only accepts
  // 0-9a-f and asserts on anything else.
  IF daylight {
    COLOR routeColor          = #7b1fa2;
    COLOR routeCasingColor    = #311b92;
  }
  ELSE {
    COLOR routeColor          = #ff000088;
    COLOR routeCasingColor    = #ffffff;
  }
  COLOR routeStartColor      = #00aa00;
  COLOR routeEndColor        = #ff0000;
  COLOR favoriteMarkerColor  = #ff8800;
  COLOR favoriteBorderColor  = #ffffff;
  COLOR searchMarkerColor    = #ff00ff;
  COLOR searchBorderColor    = #ffffff;
  COLOR trackColor           = #0088ff;
SYMBOL route_start
  CIRCLE 0,0 0.9 {
    AREA { color: @routeStartColor; }
    AREA.BORDER { color: #ffffff; width: 0.15mm; }
  }

SYMBOL route_end
  CIRCLE 0,0 0.9 {
    AREA { color: @routeEndColor; }
    AREA.BORDER { color: #ffffff; width: 0.15mm; }
  }

SYMBOL favorite_marker
  CIRCLE 0,0 1.1 {
    AREA { color: @favoriteMarkerColor; }
    AREA.BORDER { color: @favoriteBorderColor; width: 0.3mm; }
  }

SYMBOL search_marker
  CIRCLE 0,0 1.4 {
    AREA { color: @searchMarkerColor; }
    AREA.BORDER { color: @searchBorderColor; width: 0.35mm; }
  }

STYLE
  [MAG world-] {
    // Active route: a wide casing stroke under the fill so the route is
    // bordered on both sides and visible on any road color. The outline is
    // drawn first (lower priority). Colors come from the presentation branch
    // in CONST above (daylight violet, dark presentation red + white).
    [TYPE _route] WAY#outline { color: @routeCasingColor; displayWidth: 2.2mm; width: 8m; priority: 99; }
    [TYPE _route] WAY {color: @routeColor; displayWidth: 1.5mm; width: 6m; priority: 100; }

    // Imported GPX track. Rendered as a thinner blue polyline so it is
    // distinguishable from the active route. Visible from city zoom upward.
    [MAG city-] {
      [TYPE _track] WAY {color: @trackColor; displayWidth: 0.8mm; width: 4m; priority: 90; }
    }

    // Route start/end markers. Visible from city zoom upward so they do not
    // clutter the view at low magnification.
    [MAG city-] {
      [TYPE _route_start] NODE.ICON { symbol: route_start; }
      [TYPE _route_end]   NODE.ICON { symbol: route_end;   }
    }

    // Favorite and search-selection markers are rendered a bit larger and stay
    // visible from city zoom upward (the AA map starts at city zoom — keeping
    // them at [MAG detail-] would fall back to the default grey node marker).
    [MAG city-] {
      [TYPE _favorite]        NODE.ICON { symbol: favorite_marker; priority: 200; }
      [TYPE _search_selected] NODE.ICON { symbol: search_marker; priority: 250; }
    }
  }

END
