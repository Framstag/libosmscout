    POLYGON 0,-0.32 0.30,-0.10 0.19,0.26 -0.19,0.26 -0.30,-0.10 { AREA { color: @shopSymbolColor; } }
    // Seams from the pentagon corners to the rim
    POLYGON 0,-0.32 0,-1.0 { AREA.BORDER { color: @shopSymbolColor; width: 0.1mm; } }
    POLYGON 0.30,-0.10 0.95,-0.32 { AREA.BORDER { color: @shopSymbolColor; width: 0.1mm; } }
    POLYGON 0.19,0.26 0.59,0.81 { AREA.BORDER { color: @shopSymbolColor; width: 0.1mm; } }
    POLYGON -0.19,0.26 -0.59,0.81 { AREA.BORDER { color: @shopSymbolColor; width: 0.1mm; } }
    POLYGON -0.30,-0.10 -0.95,-0.32 { AREA.BORDER { color: @shopSymbolColor; width: 0.1mm; } }

