    CIRCLE -0.562,-0.225 0.562 { AREA { color: @shopSymbolColor; } }
    CIRCLE 0.562,-0.225 0.562 { AREA { color: @shopSymbolColor; } }
    POLYGON -1.125,-0.225 1.125,-0.225 0,1.125 { AREA { color: @shopSymbolColor; } }

  SYMBOL shop_surf
    // Surfboard
    RECTANGLE -0.321,-1.125 0.643 x 2.25 { AREA.BORDER { color: @shopSymbolColor; width: 0.193mm; } }
    POLYGON 0,-1.125 0,-0.804 { AREA.BORDER { color: @shopSymbolColor; width: 0.193mm; } }

  SYMBOL shop_ski
    // Skis
    RECTANGLE -0.7,-0.5 1.2 x 0.2 { AREA { color: @shopSymbolColor; } }
    POLYGON 0.5,-0.5 0.7,-0.5 0.7,-0.75 { AREA { color: @shopSymbolColor; } }
    RECTANGLE -0.2,-0.5 0.3 x 0.2 { AREA { color: lighten(@shopSymbolColor, 0.4); } }
    RECTANGLE -0.7,0.3 1.2 x 0.2 { AREA { color: @shopSymbolColor; } }
    POLYGON 0.5,0.3 0.7,0.3 0.7,0.05 { AREA { color: @shopSymbolColor; } }
    RECTANGLE -0.2,0.3 0.3 x 0.2 { AREA { color: lighten(@shopSymbolColor, 0.4); } }

  SYMBOL shop_aviation
    // Airplane
    POLYGON -0.964,-0 1.125,-0 0.804,-0.193 -0.804,-0.193 { AREA { color: @shopSymbolColor; } }
    POLYGON -0.161,-0.193 0.161,-0.193 0.482,-0.643 -0.161,-0.643 { AREA { color: @shopSymbolColor; } }
    POLYGON -0.161,-0 -0.161,0.482 0.482,0.482 0.161,-0 { AREA { color: @shopSymbolColor; } }
    POLYGON -0.964,-0.193 -1.125,-0.482 -0.804,-0.193 { AREA { color: @shopSymbolColor; } }

  SYMBOL shop_truck
    // Truck
    RECTANGLE 0.346,-0.346 0.692 x 0.865 { AREA.BORDER { color: @shopSymbolColor; width: 0.208mm; } }
    RECTANGLE -1.212,-0.346 1.558 x 0.865 { AREA.BORDER { color: @shopSymbolColor; width: 0.208mm; } }
    CIRCLE -0.692,0.519 0.26 { AREA.BORDER { color: @shopSymbolColor; width: 0.208mm; } }
    CIRCLE 0.173,0.519 0.26 { AREA.BORDER { color: @shopSymbolColor; width: 0.208mm; } }
    CIRCLE 0.779,0.519 0.26 { AREA.BORDER { color: @shopSymbolColor; width: 0.208mm; } }

  SYMBOL shop_fuel
    // Fuel pump
    RECTANGLE -0.597,-0.996 1.195 x 1.792 { AREA.BORDER { color: @shopSymbolColor; width: 0.239mm; } }
    RECTANGLE -0.398,-0.697 0.796 x 0.398 { AREA { color: @shopSymbolColor; } }
    POLYGON 0.597,0.199 1.095,0.199 { AREA.BORDER { color: @shopSymbolColor; width: 0.239mm; } }
    POLYGON 1.095,0.199 1.095,0.697 { AREA.BORDER { color: @shopSymbolColor; width: 0.239mm; } }
    CIRCLE 1.095,0.796 0.159 { AREA { color: @shopSymbolColor; } }

  SYMBOL shop_confectionery
