    RECTANGLE -0.3,0.45 0.6 x 0.3 { AREA.BORDER { color: @shopSymbolColor; width: 0.1mm; } }

  SYMBOL shop_shoes
    // Shoe (side view, pointing right)
    POLYGON -0.9,0.8 -0.9,0.35 -0.6,0.15 -0.35,0.4 -0.1,0.4 0.55,0.8 0.9,0.8 { AREA { color: @shopSymbolColor; } }
    RECTANGLE -0.9,0.55 1.8 x 0.25 { AREA.BORDER { color: @shopSymbolColor; width: 0.15mm; } }
  STYLE
    IF _building {
      [MAG @buildingMag-] {
        [GROUP shop, building] {
          AREA { color: @shopColor;}
          AREA.BORDER { color: @shopBorderColor; width: 0.1mm; }
        }

        // Per-category area colors for granular shop types. These rules
        // follow the generic rule above and thus override the base color
        // for the listed types (last matching rule wins).

        [TYPE shop_alcohol_building,
              shop_bakery_building,
              shop_beverages_building,
              shop_brewing_supplies_building,
              shop_butcher_building,
              shop_cheese_building,
              shop_chocolate_building,
              shop_coffee_building,
              shop_confectionery_building,
              shop_convenience_building,
              shop_dairy_building,
              shop_deli_building,
              shop_farm_building,
              shop_food_building,
              shop_frozen_food_building,
              shop_greengrocer_building,
              shop_grocery_building,
              shop_health_food_building,
              shop_ice_cream_building,
              shop_nuts_building,
              shop_pasta_building,
              shop_pastry_building,
              shop_seafood_building,
              shop_spices_building,
              shop_supermarket_building,
              shop_tea_building,
              shop_tortilla_building,
              shop_water_building,
              shop_wine_building] {
          AREA { color: @shopFoodColor; }
          AREA.BORDER { color: @shopFoodBorderColor; width: 0.1mm; }
        }

        [TYPE shop_department_store_building,
              shop_general_building,
              shop_kiosk_building,
              shop_mall_building,
              shop_wholesale_building] {
          AREA { color: @shopGeneralColor; }
          AREA.BORDER { color: @shopGeneralBorderColor; width: 0.1mm; }
        }

        [TYPE shop_baby_goods_building,
              shop_bag_building,
              shop_clothes_building,
              shop_fabric_building,
              shop_fashion_accessories_building,
              shop_jewelry_building,
              shop_leather_building,
              shop_sewing_building,
              shop_shoes_building,
              shop_shoe_repair_building,
              shop_tailor_building,
              shop_watches_building,
              shop_wool_building] {
          AREA { color: @shopClothingColor; }
          AREA.BORDER { color: @shopClothingBorderColor; width: 0.1mm; }
        }

        [TYPE shop_charity_building,
              shop_second_hand_building,
              shop_variety_store_building] {
          AREA { color: @shopDiscountColor; }
          AREA.BORDER { color: @shopDiscountBorderColor; width: 0.1mm; }
        }

        [TYPE shop_beauty_building,
              shop_chemist_building,
              shop_cosmetics_building,
              shop_erotic_building,
              shop_hairdresser_building,
              shop_hairdresser_supply_building,
              shop_hearing_aids_building,
              shop_herbalist_building,
              shop_massage_building,
              shop_medical_supply_building,
              shop_nutrition_supplements_building,
              shop_optician_building,
              shop_perfumery_building,
              shop_piercing_building,
              shop_tattoo_building] {
          AREA { color: @shopHealthColor; }
          AREA.BORDER { color: @shopHealthBorderColor; width: 0.1mm; }
        }

        [TYPE shop_agrarian_building,
              shop_appliance_building,
              shop_bathroom_furnishing_building,
              shop_country_store_building,
              shop_doityourself_building,
              shop_electrical_building,
              shop_energy_building,
              shop_fireplace_building,
              shop_florist_building,
              shop_garden_centre_building,
              shop_garden_furniture_building,
              shop_gas_building,
              shop_glaziery_building,
              shop_groundskeeping_building,
              shop_hardware_building,
              shop_houseware_building,
              shop_locksmith_building,
              shop_paint_building,
              shop_pottery_building,
              shop_security_building,
              shop_tool_hire_building,
              shop_trade_building] {
          AREA { color: @shopDIYColor; }
          AREA.BORDER { color: @shopDIYBorderColor; width: 0.1mm; }
        }

        [TYPE shop_antiques_building,
              shop_bed_building,
              shop_candles_building,
              shop_carpet_building,
              shop_curtain_building,
              shop_doors_building,
              shop_flooring_building,
              shop_furniture_building,
              shop_household_linen_building,
              shop_interior_decoration_building,
              shop_kitchen_building,
              shop_lighting_building,
              shop_tiles_building,
              shop_window_blind_building] {
          AREA { color: @shopFurnitureColor; }
          AREA.BORDER { color: @shopFurnitureBorderColor; width: 0.1mm; }
        }

        [TYPE shop_computer_building,
              shop_electronics_building,
              shop_hifi_building,
              shop_mobile_phone_building,
              shop_printer_ink_building,
              shop_radiotechnics_building,
              shop_telecommunication_building,
              shop_vacuum_cleaner_building] {
          AREA { color: @shopElectronicsColor; }
          AREA.BORDER { color: @shopElectronicsBorderColor; width: 0.1mm; }
        }

        [TYPE shop_atv_building,
              shop_aviation_building,
              shop_bicycle_building,
              shop_boat_building,
              shop_car_building,
              shop_car_parts_building,
              shop_car_repair_building,
              shop_caravan_building,
              shop_fishing_building,
              shop_fuel_building,
              shop_golf_building,
              shop_hunting_building,
              shop_military_surplus_building,
              shop_motorcycle_building,
              shop_motorcycle_repair_building,
              shop_outdoor_building,
              shop_scooter_building,
              shop_scuba_diving_building,
              shop_ski_building,
              shop_snowmobile_building,
              shop_sports_building,
              shop_surf_building,
              shop_swimming_pool_building,
              shop_trailer_building,
              shop_truck_building,
              shop_tyres_building] {
          AREA { color: @shopVehicleColor; }
          AREA.BORDER { color: @shopVehicleBorderColor; width: 0.1mm; }
        }

        [TYPE shop_art_building,
              shop_camera_building,
              shop_collector_building,
              shop_craft_building,
              shop_frame_building,
              shop_games_building,
              shop_model_building,
              shop_music_building,
              shop_musical_instrument_building,
              shop_photo_building,
              shop_trophy_building,
              shop_video_building,
              shop_video_games_building] {
          AREA { color: @shopArtColor; }
          AREA.BORDER { color: @shopArtBorderColor; width: 0.1mm; }
        }

        [TYPE shop_anime_building,
              shop_books_building,
              shop_gift_building,
              shop_lottery_building,
              shop_newsagent_building,
              shop_stationery_building,
              shop_ticket_building] {
          AREA { color: @shopStationeryColor; }
          AREA.BORDER { color: @shopStationeryBorderColor; width: 0.1mm; }
        }

        [TYPE shop_bookmaker_building,
              shop_cannabis_building,
              shop_copyshop_building,
              shop_dry_cleaning_building,
              shop_e_cigarette_building,
              shop_funeral_directors_building,
              shop_laundry_building,
              shop_money_lender_building,
              shop_outpost_building,
              shop_party_building,
              shop_pawnbroker_building,
              shop_pest_control_building,
              shop_pet_building,
              shop_pet_grooming_building,
              shop_pyrotechnics_building,
              shop_religion_building,
              shop_rental_building,
              shop_storage_rental_building,
              shop_tobacco_building,
              shop_toys_building,
              shop_travel_agency_building,
              shop_vacant_building,
              shop_vending_machine_building,
              shop_weapons_building,
              shop_repair_building,
              shop_estate_agent_building,
              shop_printing_building,
              shop_building_materials_building,
              shop_mobile_phone_accessories_building,
              shop_power_tools_building,
              shop_gold_buyer_building,
              shop_honey_building,
              shop_rice_building] {
          AREA { color: @shopOtherColor; }
          AREA.BORDER { color: @shopOtherBorderColor; width: 0.1mm; }
        }

      }
    }

    [MAG @labelBuildingMag-] {
      [GROUP shop, building] {
        AREA.TEXT {
          label: Name.name;
          style: emphasize;
          emphasizeColor: @emphasizeColor;
          color: @shopLabelColor;
          size: 1.0;
          priority: @labelPrioShop;}

      }
    }

    [MAG veryClose-] {
      [GROUP shop] {
        NODE.TEXT {
          label: Name.name;
          style: emphasize;
          emphasizeColor: @emphasizeColor;
          color: @shopLabelColor;
          size: 1.0;
          priority: @labelPrioShop;}
      }
    }

    [MAG veryClose-] {
      [GROUP shop] {
        NODE.ICON { symbol: shop; }
      }
    }

    [MAG closer-] {
      [TYPE shop_supermarket, shop_supermarket_building] {
        NODE.ICON { symbol: shop_supermarket; }
        AREA.ICON { symbol: shop_supermarket; }
      }

