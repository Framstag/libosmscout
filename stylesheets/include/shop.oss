    CIRCLE 0,0 0.783 { AREA { color: @shopSymbolColor; } }
    CIRCLE 0,0 0.489 { AREA.BORDER { color: lighten(@shopSymbolColor, 0.4); width: 0.235mm; } }
    POLYGON 0,0.783 0,1.467 { AREA.BORDER { color: @shopSymbolColor; width: 0.235mm; } }

  SYMBOL shop_chocolate
    // Chocolate bar
    RECTANGLE -1.125,-0.675 2.25 x 1.35 { AREA.BORDER { color: @shopSymbolColor; width: 0.27mm; } }
    POLYGON -1.125,0 1.125,0 { AREA.BORDER { color: @shopSymbolColor; width: 0.27mm; } }
    POLYGON 0,-0.675 0,0.675 { AREA.BORDER { color: @shopSymbolColor; width: 0.27mm; } }
    POLYGON -0.562,-0.675 -0.562,0.675 { AREA.BORDER { color: @shopSymbolColor; width: 0.27mm; } }
    POLYGON 0.562,-0.675 0.562,0.675 { AREA.BORDER { color: @shopSymbolColor; width: 0.27mm; } }

  SYMBOL shop_pastry
