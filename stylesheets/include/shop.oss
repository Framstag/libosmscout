    POLYGON 0,-1.286 0.643,0 0.429,0.643 0,0.964 -0.429,0.643 -0.643,0 { AREA { color: @shopSymbolColor; } }
    POLYGON 0,-0.643 0.321,0 0.214,0.429 0,0.643 -0.214,0.429 -0.321,0 { AREA { color: lighten(@shopSymbolColor, 0.4); } }

  SYMBOL shop_charity
