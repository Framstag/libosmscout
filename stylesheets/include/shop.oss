    RECTANGLE -0.562,0.938 1.125 x 0.15 { AREA { color: @shopSymbolColor; } }

  SYMBOL shop_computer
    // Computer monitor
    RECTANGLE -1.125,-1.125 2.25 x 1.575 { AREA.BORDER { color: @shopSymbolColor; width: 0.27mm; } }
    RECTANGLE -0.225,0.45 0.45 x 0.337 { AREA { color: @shopSymbolColor; } }
    RECTANGLE -0.562,0.787 1.125 x 0.18 { AREA { color: @shopSymbolColor; } }

  SYMBOL shop_doors
