OSS

  //
  // Shop
  // See https://wiki.openstreetmap.org/wiki/Key:shop
  //

  CONST
    COLOR shopColor                  = #d9bb98;
    COLOR shopSymbolColor            = darken(@shopColor, 0.2);
    COLOR shopBorderColor            = darken(@shopColor, 0.3);
    COLOR shopLabelColor             = darken(@shopColor, 0.8);

    // Per-category colors for granular shop types (values from the OSM
    // Key:shop wiki, grouped by the wiki's category sections). All colors
    // are derived from the base shop color to keep the palette coherent.
    COLOR shopFoodColor              = @shopColor;
    COLOR shopFoodBorderColor        = darken(@shopFoodColor, 0.3);
    COLOR shopGeneralColor           = darken(@shopColor, 0.1);
    COLOR shopGeneralBorderColor     = darken(@shopGeneralColor, 0.3);
    COLOR shopClothingColor          = lighten(@shopColor, 0.1);
    COLOR shopClothingBorderColor    = darken(@shopClothingColor, 0.3);
    COLOR shopDiscountColor          = darken(@shopColor, 0.2);
    COLOR shopDiscountBorderColor    = darken(@shopDiscountColor, 0.3);
    COLOR shopHealthColor            = lighten(@shopColor, 0.2);
    COLOR shopHealthBorderColor      = darken(@shopHealthColor, 0.3);
    COLOR shopDIYColor               = darken(@shopColor, 0.15);
    COLOR shopDIYBorderColor         = darken(@shopDIYColor, 0.3);
    COLOR shopFurnitureColor         = lighten(@shopColor, 0.15);
    COLOR shopFurnitureBorderColor   = darken(@shopFurnitureColor, 0.3);
    COLOR shopElectronicsColor       = darken(@shopColor, 0.25);
    COLOR shopElectronicsBorderColor = darken(@shopElectronicsColor, 0.3);
    COLOR shopVehicleColor           = darken(@shopColor, 0.3);
    COLOR shopVehicleBorderColor     = darken(@shopVehicleColor, 0.3);
    COLOR shopArtColor               = lighten(@shopColor, 0.25);
    COLOR shopArtBorderColor         = darken(@shopArtColor, 0.3);
    COLOR shopStationeryColor        = lighten(@shopColor, 0.3);
    COLOR shopStationeryBorderColor  = darken(@shopStationeryColor, 0.3);
    COLOR shopOtherColor             = darken(@shopColor, 0.05);
    COLOR shopOtherBorderColor       = darken(@shopOtherColor, 0.3);

  SYMBOL shop
    RECTANGLE 0,0 2.25 x 2.25 {
      AREA {color: @shopSymbolColor; }
    }

  SYMBOL shop_supermarket
    // Shopping cart
    POLYGON -0.703,-0.703 0.703,-0.703 0.984,0.141 -0.984,0.141 { AREA.BORDER { color: @shopSymbolColor; width: 0.169mm; } }
    RECTANGLE -0.844,-1.266 0.141 x 0.562 { AREA { color: @shopSymbolColor; } }
    RECTANGLE -0.844,-1.266 0.633 x 0.141 { AREA { color: @shopSymbolColor; } }
    CIRCLE -0.633,0.352 0.141 { AREA.BORDER { color: @shopSymbolColor; width: 0.169mm; } }
    CIRCLE 0.633,0.352 0.141 { AREA.BORDER { color: @shopSymbolColor; width: 0.169mm; } }

  SYMBOL shop_bakery
    // Bread loaf
    POLYGON -1.125,-0.281 -0.703,-0.844 0.703,-0.844 1.125,-0.281 0.703,0.422 -0.703,0.422 { AREA.BORDER { color: @shopSymbolColor; width: 0.169mm; } }
    RECTANGLE -0.562,-0.141 0.422 x 0.113 { AREA { color: @shopSymbolColor; } }
    RECTANGLE -0.141,-0.352 0.422 x 0.113 { AREA { color: @shopSymbolColor; } }
    RECTANGLE 0.281,-0.562 0.422 x 0.113 { AREA { color: @shopSymbolColor; } }

