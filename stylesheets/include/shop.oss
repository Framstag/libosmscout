    RECTANGLE -0.27,-0.9 0.54 x 0.72 { AREA.BORDER { color: @shopSymbolColor; width: 0.216mm; } }
    RECTANGLE -0.36,-1.17 0.72 x 0.27 { AREA { color: @shopSymbolColor; } }
    RECTANGLE -0.36,0.18 0.72 x 0.54 { AREA { color: @shopSymbolColor; } }

  SYMBOL shop_coin
    // Coin
    CIRCLE 0,0 1.125 { AREA.BORDER { color: @shopSymbolColor; width: 0.375mm; } }
    CIRCLE 0,0 0.75 { AREA.BORDER { color: @shopSymbolColor; width: 0.3mm; } }

  SYMBOL shop_lighting
    // Light bulb
    CIRCLE 0,0 0.9 { AREA.BORDER { color: @shopSymbolColor; width: 0.15mm; } }
    RECTANGLE -0.2,0.75 0.4 x 0.25 { AREA { color: @shopSymbolColor; } }
    POLYGON -0.25,0.3 -0.1,0.1 0.1,0.3 0.25,0.1 { AREA.BORDER { color: @shopSymbolColor; width: 0.12mm; } }

  SYMBOL shop_sports
