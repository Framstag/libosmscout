  //     DESC
  //       en: "converter"
  //       de: "Stromrichter"

  //
  // Regions, locations, cities stuff
  //

  // Do not delete the following type, they are required by the GenLocation import step
  TYPE boundary_country
    = WAY AREA ("boundary"=="administrative" AND "admin_level"=="2") OR
      RELATION ("type"=="boundary" AND "boundary"=="administrative" AND "admin_level"=="2")
      {Name, NameAlt, AdminLevel}
      MULTIPOLYGON IGNORESEALAND OPTIMIZE_LOW_ZOOM
      DESC
        en: "national border"
        de: "Staatsgrenze"

  TYPE boundary_state
    = WAY AREA ("boundary"=="administrative" AND "admin_level"=="4") OR
      RELATION ("type"=="boundary" AND "boundary"=="administrative" AND "admin_level"=="4")
      {Name, NameAlt, AdminLevel}
      MULTIPOLYGON IGNORESEALAND OPTIMIZE_LOW_ZOOM
      DESC
        en: "state boundary"
        de: "Bundeslandgrenze"

  TYPE boundary_county
    = WAY AREA ("boundary"=="administrative" AND "admin_level"=="6") OR
      RELATION ("type"=="boundary" AND "boundary"=="administrative" AND "admin_level"=="6")
      {Name, NameAlt, AdminLevel}
      MULTIPOLYGON IGNORESEALAND OPTIMIZE_LOW_ZOOM
      DESC
        en: "county boundary"
        de: "Kreisgrenze"

  TYPE boundary_municipality
    = WAY AREA ("boundary"=="administrative" AND "admin_level"=="8") OR
      RELATION ("type"=="boundary" AND "boundary"=="administrative" AND "admin_level"=="8")
      {Name, NameAlt, AdminLevel}
      MULTIPOLYGON IGNORESEALAND OPTIMIZE_LOW_ZOOM
      DESC
        en: "municipality boundary"
        de: "Gemeindegrenze"

  TYPE boundary_suburb
    = WAY AREA ("boundary"=="administrative" AND "admin_level"=="10") OR
      RELATION ("type"=="boundary" AND "boundary"=="administrative" AND "admin_level"=="10")
      {Name, NameAlt, AdminLevel}
      MULTIPOLYGON IGNORESEALAND OPTIMIZE_LOW_ZOOM
      DESC
        en: "suburb boundary"
        de: "Stadtteilgrenze"

  TYPE boundary_administrative
    = WAY AREA ("boundary"=="administrative") OR
      RELATION ("type"=="boundary" AND "boundary"=="administrative")
      {Name, NameAlt, AdminLevel}
      MULTIPOLYGON IGNORESEALAND OPTIMIZE_LOW_ZOOM
      DESC
        en: "administrative boundary"
        de: "Verwaltungsgrenze"

  TYPE place_continent
    = NODE AREA ("place"=="continent")
      {Name, NameAlt, IsIn}
      DESC
        en: "continent"
        de: "Kontinent"

  // Not part of the administrative boundary hierachy?
  TYPE place_peninsula IGNORE
    = NODE AREA ("place"=="peninsula")
      {Name, NameAlt}
      DESC
        en: "peninsula"
        de: "Halbinsel"

  TYPE place_country
    = NODE ("place"=="country")
      {Name, NameAlt, IsIn}
      DESC
        en: "country"
        de: "Land"

  TYPE place_state
    = NODE AREA ("place"=="state")
      {Name, NameAlt, IsIn}
      DESC
        en: "state"
        de: "Bundesland"

  TYPE place_region
    = NODE AREA ("place"=="region")
      {Name, NameAlt, IsIn}
      DESC
        en: "region"
        de: "Region"

  TYPE place_county
    = NODE AREA ("place"=="county")
      {Name, NameAlt, IsIn}
      DESC
        en: "county"
        de: "Landkreis"

