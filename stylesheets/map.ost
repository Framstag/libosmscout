      {Name, NameAlt, ConstructionYear}
      ADDRESS POI
      GROUP historic, routingPOI

  TYPE historic_tomb
    = NODE AREA ("historic"=="tomb")
      {Name, NameAlt, ConstructionYear}
      ADDRESS POI
      GROUP historic, routingPOI

  TYPE historic_tower_building
    = AREA ("historic"=="tower" AND EXISTS "building" AND !("building" IN ["no","false","0"]))
      {Name, NameAlt, ConstructionYear}
      ADDRESS POI
      GROUP historic, building, routingPOI

  TYPE historic_tower
    = NODE AREA ("historic"=="tower")
      {Name, NameAlt, ConstructionYear}
      ADDRESS POI
      GROUP historic, routingPOI

  TYPE historic_tree_shrine
    = NODE ("historic"=="tree_shrine")
      {Name, NameAlt, ConstructionYear}
      ADDRESS POI
      GROUP historic, routingPOI

  TYPE historic_vehicle
    = NODE AREA ("historic"=="vehicle")
      {Name, NameAlt, ConstructionYear}
      ADDRESS POI
      GROUP historic, routingPOI

  TYPE historic_warehouse_building
    = AREA ("historic"=="warehouse" AND EXISTS "building" AND !("building" IN ["no","false","0"]))
      {Name, NameAlt, ConstructionYear}
      ADDRESS POI
      GROUP historic, building, routingPOI

  TYPE historic_warehouse
    = NODE AREA ("historic"=="warehouse")
      {Name, NameAlt, ConstructionYear}
      ADDRESS POI
      GROUP historic, routingPOI

  TYPE historic_watermill_building
    = AREA ("historic"=="watermill" AND EXISTS "building" AND !("building" IN ["no","false","0"]))
      {Name, NameAlt, ConstructionYear}
      ADDRESS POI
      GROUP historic, building, routingPOI

  TYPE historic_watermill
    = NODE AREA ("historic"=="watermill")
      {Name, NameAlt, ConstructionYear}
      ADDRESS POI
      GROUP historic, routingPOI

  TYPE historic_wayside_cross
    = NODE ("historic"=="wayside_cross")
      {Name, NameAlt, ConstructionYear}
      ADDRESS POI
      GROUP historic, routingPOI

  TYPE historic_wayside_shrine
    = NODE WAY AREA ("historic"=="wayside_shrine")
      {Name, NameAlt, Width, Grade, Bridge, Tunnel, Roundabout, ConstructionYear}
      ADDRESS POI
      GROUP historic, routingPOI

  TYPE historic_building
    = AREA (EXISTS "historic" AND EXISTS "building" AND !("building" IN ["no","false","0"]))
      {Name, NameAlt, ConstructionYear}
      ADDRESS POI
      GROUP historic, building, routingPOI

  TYPE historic
    = NODE AREA (EXISTS "historic" AND !("historic" IN ["citywalls"]) AND !("barrier"=="city_wall"))
      {Name, NameAlt, ConstructionYear}
      ADDRESS POI
      GROUP historic

  //
  // Military
  //

  TYPE military_airfield
    = NODE AREA ("military"=="airfield")
      {Name, NameAlt}
      ADDRESS

  TYPE military_bunker_building
    = NODE AREA ("military"=="bunker" AND EXISTS "building" AND !("building" IN ["no","false","0"]))
      {Name, NameAlt}
      ADDRESS
      GROUP building

  TYPE military_bunker
    = NODE AREA ("military"=="bunker")
      {Name, NameAlt}
      ADDRESS

  TYPE military_barracks
    = NODE AREA ("military"=="barracks")
      {Name, NameAlt}
      ADDRESS

  TYPE military_danger_area
    = NODE AREA ("military"=="danger_area")
      {Name, NameAlt}
      MERGE_AREAS

  TYPE military_range
    = NODE AREA ("military"=="range")
      {Name, NameAlt}
      MERGE_AREAS

  TYPE military_naval_base
    = NODE AREA ("military"=="naval_base")
      {Name, NameAlt}
      ADDRESS

  TYPE military_ammunition
    = NODE AREA ("military"=="ammunition")
      {Name, NameAlt}
      MERGE_AREAS

  TYPE military_base
    = NODE AREA ("military"=="base")
      {Name, NameAlt}
      ADDRESS

  TYPE military_cannon
    = NODE ("military"=="cannon")
      {Name, NameAlt}
      POI

  TYPE military_checkpoint
    = NODE ("military"=="checkpoint")
      {Name, NameAlt}
      POI

  TYPE military_cordon
    = WAY ("military"=="cordon")
      {Name, NameAlt}

  TYPE military_embrasure
    = NODE ("military"=="embrasure")
      {Name, NameAlt}
      POI

  TYPE military_nuclear_explosion_site
    = NODE AREA ("military"=="nuclear_explosion_site")
      {Name, NameAlt}
      MERGE_AREAS

  TYPE military_obstacle_course
    = WAY AREA ("military"=="obstacle_course")
      {Name, NameAlt}
      POI

  TYPE military_office
    = NODE AREA ("military"=="office")
      {Name, NameAlt, OpeningHours, Phone, Website}
      ADDRESS POI
      GROUP office, routingPOI

  TYPE military_police
    = NODE AREA ("military"=="police")
      {Name, NameAlt}
      POI

  TYPE military_radar
    = NODE AREA ("military"=="radar")
      {Name, NameAlt}
      POI

  TYPE military_road
    = WAY ("military"=="road")
      {Name, NameAlt}

  TYPE military_shelter
    = WAY AREA ("military"=="shelter")
      {Name, NameAlt}
      POI

  TYPE military_training_area
    = AREA ("military"=="training_area")
      {Name, NameAlt}
      MERGE_AREAS

  TYPE military_trench
    = NODE WAY ("military"=="trench")
      {Name, NameAlt}

  //
  // Sport
  // INFO: We expect that only the "node" variant will appear, since the area version should be
  // handled by "building", "pitch" or similar areas.
  // See http://wiki.openstreetmap.org/wiki/Key:sport
  //

  TYPE sport_building
    = AREA (EXISTS "sport" AND EXISTS "building" AND !("building" IN ["no","false","0"]))
      {Name, NameAlt}
      ADDRESS
      GROUP building

  TYPE sport_9pin
    = NODE AREA ("sport"=="9pin")
      {Name, NameAlt}
      ADDRESS

  TYPE sport_10pin
    = NODE AREA ("sport"=="10pin")
      {Name, NameAlt}
      ADDRESS

  TYPE sport_archery
    = NODE AREA ("sport"=="archery")
      {Name, NameAlt}
      ADDRESS

