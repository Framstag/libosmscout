  //
  // Railways and assorted
  //

  TYPE railway_rail
    = WAY ("railway"=="rail")
      {Bridge, Tunnel, Width}
      OPTIMIZE_LOW_ZOOM
      DESC
        en: "railway line"
        de: "Bahnstrecke"

  TYPE railway_tram
    = WAY ("railway"=="tram")
      {Bridge, Tunnel, Width}
      DESC
        en: "tram line"
        de: "Straßenbahn"

  TYPE railway_light_rail
    = WAY ("railway"=="light_rail")
      {Bridge, Tunnel, Width}
      OPTIMIZE_LOW_ZOOM
      DESC
        en: "light rail"
        de: "Stadtbahn"

  TYPE railway_subway
    = WAY ("railway"=="subway")
      {Name, Bridge, Tunnel, Width}
      DESC
        en: "subway"
        de: "U-Bahn"

  TYPE railway_preserved
    = WAY ("railway"=="preserved")
      {Name, Bridge, Tunnel, Width}
      OPTIMIZE_LOW_ZOOM
      DESC
        en: "heritage railway"
        de: "Museumsbahn"

  TYPE railway_disused
    = WAY ("railway"=="disused")
      {Bridge, Tunnel, Width}
      DESC
        en: "disused railway"
        de: "Stillgelegte Bahnstrecke"

  TYPE railway_abandoned
    = WAY ("railway"=="abandoned")
      {Bridge, Tunnel, Width}
      DESC
        en: "abandoned railway"
        de: "Aufgegebene Bahnstrecke"

  TYPE railway_narrow_gauge
    = WAY ("railway"=="narrow_gauge")
      {Name, Bridge, Tunnel, Width}
      OPTIMIZE_LOW_ZOOM
      DESC
        en: "narrow-gauge railway"
        de: "Schmalspurbahn"

  TYPE railway_monorail
    = WAY ("railway"=="monorail")
      {Name, Bridge, Tunnel, Width}
      DESC
        en: "monorail"
        de: "Einschienenbahn"

  TYPE railway_funicular
    = WAY ("railway"=="funicular")
      {Name, Bridge, Tunnel, Width}
      DESC
        en: "funicular"
        de: "Standseilbahn"

  TYPE railway_station
    = NODE AREA ("railway"=="station")
      {Name, NameAlt, Operator, Brand}
      ADDRESS POI
      GROUP routingPOI
      DESC
        en: "railway station"
        de: "Bahnhof"

  TYPE railway_halt
    = NODE ("railway"=="halt")
      {Name, NameAlt, Operator, Brand}
      DESC
        en: "railway halt"
        de: "Haltepunkt"

  TYPE railway_tram_stop
    = NODE ("railway"=="tram_stop" OR (("tram" IN ["yes", "true", "1"]) AND ("public_transport" IN ["platform", "stop_position"])))
      {Name, NameAlt, Operator, Brand}
      DESC
        en: "tram stop"
        de: "Straßenbahnhaltestelle"

  TYPE railway_crossing
    = NODE ("railway"=="crossing")
      DESC
        en: "level crossing"
        de: "Bahnübergang"

  TYPE railway_level_crossing
    = NODE ("railway"=="level_crossing")
      DESC
        en: "level crossing"
        de: "Bahnübergang"

  TYPE railway_subway_entrance
    = NODE ("railway"=="subway_entrance")
      {Name, NameAlt, Operator, Brand}
      DESC
        en: "subway entrance"
        de: "U-Bahn-Eingang"

  TYPE railway_turntable
    = NODE AREA ("railway"=="turntable")
      {Bridge, Tunnel}
      DESC
        en: "turntable"
        de: "Drehscheibe"

