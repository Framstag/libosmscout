OST

/*
  Please see http://libosmscout.sourceforge.net/documentation/typedef/ for a detailed
  description of the format of this file. The documentation below contains only the
  most important information and is not a complete description.

  Types:
    A type can be support for any of the following types:
    * NODE
    * WAY: Ways automatically get assigned the following features: Layer
    * AREA
    * RELATION

  Meaning of the different OPTIONS:
    PATH[[FOOT] [BICYLCE] [CAR]]:
      This way or area is a traversable path and possibly routable for the given vehicles.

      See: http://wiki.openstreetmap.org/wiki/OSM_tags_for_routing/Access-Restrictions

      If something is a path, the following features are automatically assigned:
      * Width
      * Grade
      * Bridge
      * Tunnel
      * Roundabout
      If something is routable, the following features are automatically assigned:
      * Access
      * MaxSpeed
    OPTIMIZE_LOW_ZOOM:
      Optimize this area or way for displaying in low zoom by
      reducing visible complexity
    PIN_WAY:
      This is a way, even if the path is closed
    MULTIPOLYGON:
      Type should be handled as multipolygon even if type is not set to multipolygon.
    ROUTE_MASTER:
      Type should be handled as route master relation (public transport schema)..
    ROUTE:
      Type should be handled as route relation.
    ADMIN_REGION:
      The given area or node describes an administrate region
      that should be part of the region tree for the city/street
      index
    POI:
      The given area, way or node is a POI and should be indexed
      by its name in relation to the enclosing region. If something is a POI and has the
      feature "Name"
      It automatically get the following features assigned:
      * Location
      * Address
      * Website
      * Phone
      * OpeningHours
    ADDRESS:
      Objects should be indexed as address
      It automatically get the following features assigned:
      * Location
      * Address
    LOCATION:
      The given way or area should be indexed as location.
    MERGE_AREAS:
      Areas of this type that "touch" each other and the same attribute values
      will get merged.
    IGNORESEALAND:
      Ignore this type for calculation of land masses (because objects of this type can
      occur on sea, too, and thus have no distinguishing character).
    LANES[bidirectional oneway]:
      Default value for the number of lanes, if the way is either bidirectional or
      oneway. Default value will be overwritten during parsing of concrete ways by the
      actual values.
    IGNORE:
      Ignore objects of this type
*/

MODULE "max_speeds"

/*
  Allows you to map surface descriptions to a grade value ([1-5]).
  Grade 1 ist very well, grade 5 is very bad.
*/
GRADES
  SURFACE GRADE 1 {
    "paved"
    "asphalt"
    "cobblestone"
    "cobblestone:flattened"
    "unhewn_cobblestone"
    "concrete"
    "concrete:lanes"
    "concrete:plates"
    "paving_stones"
    "paving_stones:20"
    "paving_stones:30"
    "sett"
    "tarred"
    "tartan"
    "iron"
  }

  SURFACE GRADE 2 {
    "ash"
    "clay"
    "compacted"
    "compacted_gravel"
    "fine_gravel"
    "gravel"
    "grass_paver"
    "metal"
    "pebblestone"
    "stone"
    "wood"
    "marble"
    "panel"
  }

  SURFACE GRADE 3 {
    "unpaved"
    "dirt"
    "dirt/sand"
    "earth"
    "grass"
    "ground"
    "mud"
    "sand"
    "soil"
    "woodchips"
  }

  SURFACE GRADE 4 {
    "artificial_turf"
    "bark_mulch"
    "stones"
    "rock"
    "rocks"
  }

/*
  Allows to give features a localized name. This can be helpful for
  UI visualisation.
*/
FEATURES
  FEATURE Address
  DESC
    en: "Address"
    de: "Adresse"

  FEATURE AdminLevel
  DESC
    en: "administrative level"
    de: "Administrative Hierachie"

  FEATURE Destination
  DESC
    en: "destination"
    de: "Ziel"

  FEATURE Name
  DESC
    en: "object name"
    de: "Objektname"

  FEATURE NameAlt
  DESC
    en: "object name"
    de: "Objektname"

  FEATURE Width
  DESC
    en: "width"
    de: "Breite"

  FEATURE Access
  DESC
    en: "access"
    de: "Zugang"

  FEATURE AccessRestricted
  DESC
    en: "restricted access"
    de: "eingeschränkter Zugang"

  FEATURE Brand
  DESC
    en: "brand"
    de: "Marke"

  FEATURE Bridge
  DESC
    en: "bridge"
    de: "Brücke"

  FEATURE ChargingStation
  DESC
    en: "charging station"
    de: "Ladestation"

  FEATURE ClockwiseDirection
  DESC
    en: "direction of travel"
    de: "Fahrtrichtung"

  FEATURE ConstructionYear
  DESC
    en: "year of construction"
    de: "Baujahr"

  FEATURE Embankment
  DESC
    en: "embankment"
    de: "Damm"

  FEATURE Fee
  DESC
    en: "fee"
    de: "Gebühr"

  FEATURE Grade
  DESC
    en: "slope"
    de: "Steigung"

  // Present but NOT enabled (guidelines/FileFormatVersion.md, "A feature that exists but is not
  // enabled"): listing it here and on a type makes databases built from this file unreadable for
  // older library builds, which needs a FILE_FORMAT_VERSION bump and a provider re-import.
  // FEATURE Toll
  // DESC
  //   en: "toll"
  //   de: "Maut"

  FEATURE HighwayMilestone
  DESC
    en: "milestone"
    de: "Kilometerstein"

  FEATURE IsIn
  DESC
    en: "located in"
    de: "Liegt in"

  FEATURE Lanes
  DESC
    en: "lanes"
    de: "Fahrstreifen"

  FEATURE Layer
  DESC
    en: "layer"
    de: "Ebene"

  FEATURE MaxSpeed
  DESC
    en: "maximum speed"
    de: "Höchstgeschwindigkeit"

  FEATURE MaxStay
  DESC
    en: "maximum stay"
    de: "Höchstdauer"

  FEATURE Network
  DESC
    en: "network"
    de: "Netz"

  FEATURE OpeningHours
  DESC
    en: "opening hours"
    de: "Öffnungszeiten"

  FEATURE Operator
  DESC
    en: "operator"
    de: "Betreiber"

  FEATURE Phone
  DESC
    en: "phone"
    de: "Telefon"

  FEATURE PostalCode
  DESC
    en: "postal code"
    de: "Postleitzahl"

  FEATURE Ref
  DESC
    en: "reference"
    de: "Referenz"

  FEATURE Roundabout
  DESC
    en: "roundabout"
    de: "Kreisverkehr"

  FEATURE ShortName
  DESC
    en: "short name"
    de: "Kurzname"

  FEATURE Sideway
  DESC
    en: "side path"
    de: "Seitenweg"

  FEATURE Tunnel
  DESC
    en: "tunnel"
    de: "Tunnel"

  FEATURE Website
  DESC
    en: "website"
    de: "Webseite"

MODULE "contour_lines"
MODULE "motorways"

TYPES

  // Types marked PARKED-NEW-TYPE are inactive. They are kept here, commented, so
  // enabling them later is a local edit instead of a restore from history.
  // See TODO.md and openspec/changes/park-new-types-and-styles/ for the reason,
  // the name list and the analysis that has to exist before they are enabled.
  // Ways with main designation different to car

  TYPE highway_track
    = WAY AREA ("highway"=="track")
      {Name, NameAlt, Sideway}
      PATH[FOOT BICYCLE] LOCATION PIN_WAY
      DESC
        en: "track"
        de: "Wirtschaftsweg"

  TYPE highway_pedestrian
    = WAY AREA ("highway"=="pedestrian")
      {Name, NameAlt, Sideway}
      PATH[FOOT] LOCATION PIN_WAY MERGE_AREAS
      DESC
        en: "pedestrian"
        de: "Fußgängerzone"

  TYPE highway_path
    = WAY AREA ("highway"=="path")
      {Name, NameAlt, Sideway}
      PATH[FOOT BICYCLE] IGNORESEALAND PIN_WAY
      DESC
        en: "path"
        de: "Merhzweckweg"

  TYPE highway_cycleway
    = WAY ("highway"=="cycleway")
      {Name, NameAlt}
      PATH[FOOT BICYCLE] PIN_WAY
      DESC
        en: "cycleway"
        de: "Fahradweg"

  TYPE highway_footway
    = WAY AREA ("highway"=="footway") OR AREA ("area:highway"=="footway")
      {Name, NameAlt}
      PATH[FOOT BICYCLE] LOCATION PIN_WAY
      DESC
        en: "footway"
        de: "Fußweg"

  TYPE highway_via_ferrata_easy
    = WAY (("highway"=="via_ferrata") AND (("via_ferrata_scale"=="0") OR ("via_ferrata_scale"=="0+") OR ("via_ferrata_scale"=="1-") OR ("via_ferrata_scale"=="1") OR ("via_ferrata_scale"=="1+")))
      {Name, NameAlt}
      DESC
        en: "via ferrata, easy"
        de: "Klettersteig (leicht)"

  TYPE highway_via_ferrata_moderate
    = WAY (("highway"=="via_ferrata") AND (("via_ferrata_scale"=="2-") OR ("via_ferrata_scale"=="2") OR ("via_ferrata_scale"=="2+")))
      {Name, NameAlt}
      DESC
        en: "via ferrata, moderate"
        de: "Klettersteig (mittel)"

  TYPE highway_via_ferrata_difficult
    = WAY (("highway"=="via_ferrata") AND (("via_ferrata_scale"=="3-") OR ("via_ferrata_scale"=="3") OR ("via_ferrata_scale"=="3+") OR ("via_ferrata_scale"=="4-") OR ("via_ferrata_scale"=="4") OR ("via_ferrata_scale"=="4+")))
      {Name, NameAlt}
      DESC
        en: "via ferrata, difficult"
        de: "Klettersteig (schwierig)"

  TYPE highway_via_ferrata_extreme
    = WAY (("highway"=="via_ferrata") AND (("via_ferrata_scale"=="5-") OR ("via_ferrata_scale"=="5") OR ("via_ferrata_scale"=="5+") OR ("via_ferrata_scale"=="6-") OR ("via_ferrata_scale"=="6") OR ("via_ferrata_scale"=="6+")))
      {Name, NameAlt}
      DESC
        en: "via ferrata, extreme"
        de: "Klettersteig (extrem)"

  TYPE highway_bridleway
    = WAY AREA ("highway"=="bridleway")
      {Name, NameAlt}
      PATH PIN_WAY
      DESC
        en: "bridleway"
        de: "Reitweg"

  TYPE highway_steps
    = WAY ("highway"=="steps")
      {Name, NameAlt}
      PATH[FOOT]
      DESC
        en: "steps"
        de: "Treppe"

  TYPE highway_services
    = NODE AREA ("highway"=="services")
      {Name, NameAlt}
      ADDRESS
      GROUP routingPOI
      DESC
        en: "services"
        de: "Raststätte"

  TYPE highway_bus_guideway
    = WAY ("highway"=="bus_guideway")
      {Name, NameAlt, Ref}
      PATH
      DESC
        en: "bus guideway"
        de: "Busfahrbahn"

  TYPE highway_mini_roundabout
    = NODE ("highway"=="mini_roundabout")
      {Name, NameAlt, ClockwiseDirection}
      DESC
        en: "mini-roundabout"
        de: "Mini-Kreisverkehr"

  TYPE highway_turning_cycle
    = NODE ("highway"=="turning_cycle")
      {Name, NameAlt}
      DESC
        en: "turning circle"
        de: "Wendehammer"

  TYPE highway_construction
    = WAY ("highway"=="construction")
      {Name, NameAlt, Width}
      DESC
        en: "road under construction"
        de: "Straße im Bau"

  TYPE highway_roundabout
    = WAY AREA ("highway"=="roundabout")
      {Name, NameAlt}
      PATH[FOOT BICYCLE CAR] PIN_WAY
      DESC
        en: "roundabout"
        de: "Kreisverkehr"

  TYPE highway_motorway_junction
    = NODE ("highway"=="motorway_junction")
      {Name, NameAlt, Ref}
      PATH[CAR]
      DESC
        en: "motorway junction"
        de: "Autobahnanschlussstelle"

  TYPE highway_street_lamp
     // Too many for mobile offline map?
    = NODE ("highway"=="street_lamp")
      {Brand, Operator, MaxStay, ChargingStation}
      DESC
        en: "street lamp"
        de: "Straßenlaterne"

  // Since rendering of speed cameras is not allowed everywhere, it is disabled by default
  TYPE speed_camera
    IGNORE
    = NODE ("highway"=="speed_camera")
      DESC
        en: "speed camera"
        de: "Blitzer"

  TYPE highway_traffic_signals
    IGNORE // No visualisation yet
    = NODE ("highway"=="traffic_signals")
      DESC
        en: "traffic lights"
        de: "Ampel"

