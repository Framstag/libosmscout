  //
  // Amenity
  //

  // These are currently special-cased in the style file
  TYPE amenity_atm
    = NODE AREA ("amenity"=="atm")
      {Name, NameAlt, Operator, Brand, OpeningHours}
      GROUP amenity
      DESC
        en: "cash machine"
        de: "Geldautomat"

  TYPE amenity_bank_building
    = AREA ("amenity"=="bank" AND EXISTS "building" AND !("building" IN ["no","false","0"]))
      {Name, NameAlt, Operator, Brand, OpeningHours, Phone, Website}
      POI
      GROUP amenity, building
      DESC
        en: "bank"
        de: "Bank"

  TYPE amenity_bank
    = NODE AREA ("amenity"=="bank")
      {Name, NameAlt, Operator, Brand, OpeningHours, Phone, Website}
      ADDRESS POI
