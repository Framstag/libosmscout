  TYPE waterway_weir
    = NODE WAY AREA ("waterway"=="weir")
      {Name, NameAlt, Width}
      IGNORESEALAND
      DESC
        en: "weir"
        de: "Wehr"

  // waterway_waterfall also covers the deprecated natural=waterfall tag:
  // both variants share this single type definition (see PR #1769).
  TYPE waterway_waterfall
    = NODE WAY AREA ("waterway"=="waterfall") OR NODE WAY AREA ("natural"=="waterfall")
      {Name, NameAlt, Width}
      IGNORESEALAND
      DESC
        en: "waterfall"
        de: "Wasserfall"

