  TYPE place_capitalcity
    = NODE AREA ("place"=="city" AND EXISTS "capital" AND "capital"=="yes")
      {Name, NameAlt, IsIn}
      ADMIN_REGION
      DESC
        en: "capital"
        de: "Hauptstadt"

  TYPE place_millioncity
    = NODE AREA ("place"=="city" AND EXISTS "population" AND "population">1000000)
      {Name, NameAlt, IsIn}
      ADMIN_REGION
      DESC
        en: "city of a million"
        de: "Millionenstadt"

  TYPE place_halfmillioncity
    = NODE AREA ("place"=="city" AND EXISTS "population" AND "population">500000)
      {Name, NameAlt, IsIn}
      ADMIN_REGION
      DESC
        en: "city of half a million"
        de: "Halbmillionenstadt"

  TYPE place_bigcity
    = NODE AREA ("place"=="city" AND EXISTS "population" AND "population">100000)
      {Name, NameAlt, IsIn}
      ADMIN_REGION
      DESC
        en: "big city"
        de: "Großstadt"

