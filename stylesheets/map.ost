  TYPE waterway_stream
    = WAY ("waterway"=="stream")
      {Name, NameAlt, Width, Tunnel}
      OPTIMIZE_LOW_ZOOM IGNORESEALAND PIN_WAY
      DESC
        en: "stream"
        de: "Bach"

  TYPE waterway_river
    = WAY ("waterway"=="river")
      {Name, NameAlt, Width, Tunnel}
      OPTIMIZE_LOW_ZOOM IGNORESEALAND PIN_WAY
      DESC
        en: "river"
        de: "Fluss"

  TYPE waterway_riverbank
    = AREA ("waterway"=="riverbank" OR ("natural"=="water" AND  "water"=="river"))
      {Name, NameAlt, Width}
      MERGE_AREAS
      DESC
        en: "riverbank"
        de: "Flussufer"

  TYPE waterway_canal
    = WAY AREA ("waterway"=="canal")
      {Name, NameAlt, Width}
      OPTIMIZE_LOW_ZOOM IGNORESEALAND
      DESC
        en: "canal"
        de: "Kanal"

  TYPE waterway_ditch
    = WAY ("waterway"=="ditch")
      {Name, NameAlt, Width}
      OPTIMIZE_LOW_ZOOM IGNORESEALAND
      DESC
        en: "ditch"
        de: "Graben"

  TYPE waterway_drain
