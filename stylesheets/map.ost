  TYPE shop_building
    = AREA (EXISTS "shop" AND EXISTS "building" AND !("building" IN ["no","false","0"]))
      {Name, NameAlt, OpeningHours, Phone, Website}
      ADDRESS POI
      GROUP shop, building, routingPOI
      DESC
        en: "shop building"
        de: "Geschäftshaus"

  TYPE shop
    = NODE AREA (EXISTS "shop")
      {Name, NameAlt, OpeningHours, Phone, Website}
      ADDRESS POI
      GROUP shop, routingPOI
      DESC
        en: "shop"
        de: "Geschäft"

