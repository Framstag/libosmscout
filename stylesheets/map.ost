  //
  // Additional amenity types (values from the OSM Key:amenity wiki and taginfo,
  // usage >= 0.01%). Element types follow the corresponding OSM wiki tag pages.
  //

  // Sustenance

  TYPE amenity_biergarten
    = NODE AREA ("amenity"=="biergarten")
      {Name, NameAlt, OpeningHours, Phone, Website}
      ADDRESS POI
      GROUP amenity, routingPOI

  TYPE amenity_food_court
    = NODE AREA ("amenity"=="food_court")
      {Name, NameAlt, OpeningHours, Phone, Website}
      ADDRESS POI
      GROUP amenity, routingPOI

  TYPE amenity_ice_cream
    = NODE AREA ("amenity"=="ice_cream")
      {Name, NameAlt, OpeningHours, Phone, Website}
      ADDRESS POI
      GROUP amenity, routingPOI

