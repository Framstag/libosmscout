  TYPE office_building
    = AREA (EXISTS "office" AND EXISTS "building" AND !("building" IN ["no","false","0"]))
      {Name, NameAlt, OpeningHours, Phone, Website}
      ADDRESS
      GROUP office, building, routingPOI
      DESC
