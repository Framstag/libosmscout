        en: "ocean"
        de: "Ozean"

  //
  // Buildings
  //

  TYPE building_garage
    = AREA ("building"=="garage")
      GROUP building
      DESC
        en: "garage"
        de: "Garage"

  TYPE building
    = AREA (EXISTS "building" AND !("building" IN ["no","false","0"]))
      {Name, NameAlt}
      ADDRESS
      GROUP building
      DESC
        en: "building"
        de: "Gebäude"

  // Addresses
  TYPE address
    = NODE AREA ((EXISTS "addr:street" OR EXISTS "addr:place") AND EXISTS "addr:housenumber")
      ADDRESS

