    = NODE AREA ("sport"=="rowing")
      {Name, NameAlt}
      ADDRESS

  TYPE sport_rugby
    = NODE AREA ("sport"=="rugby")
      {Name, NameAlt}
      ADDRESS

  TYPE sport_shooting
    = NODE AREA ("sport"=="shooting")
      {Name, NameAlt}
      ADDRESS

  TYPE sport_skating
    = NODE AREA ("sport"=="skating")
      {Name, NameAlt}
      ADDRESS

  TYPE sport_skateboard
    = NODE AREA ("sport"=="skateboard")
      {Name, NameAlt}
