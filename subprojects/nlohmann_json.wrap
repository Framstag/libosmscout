# nlohmann_json: the header-only JSON implementation the import library uses to
# read and write the db.json database metadata. Taken from wrapdb, so a Meson
# build works on platforms without a system package for it (MSVC, for example);
# a system installation is preferred and this is only the fallback.
[wrap-file]
directory = nlohmann_json-3.12.0
lead_directory_missing = true

source_url = https://github.com/nlohmann/json/releases/download/v3.12.0/include.zip
source_filename = nlohmann_json-3.12.0.zip
source_hash = b8cb0ef2dd7f57f18933997c9934bb1fa962594f701cd5a8d3c2c80541559372

[provide]
nlohmann_json = nlohmann_json_dep
